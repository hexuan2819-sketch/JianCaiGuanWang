<script define:vars={{ cases: meta.cases.items, support: meta.support.items, blog: meta.blog.items, isZh }}>
  if (typeof window !== 'undefined') {
    /* ── 案例：原位展开 ── */
    const caseTriggers = document.querySelectorAll('[data-case-trigger]');
    const casePanel = document.getElementById('case-expand-panel');
    const caseTag = document.getElementById('case-expand-tag');
    const caseTitle = document.getElementById('case-expand-title');
    const caseScale = document.getElementById('case-expand-scale');
    const caseDetail = document.getElementById('case-expand-detail');
    const caseProduct = document.getElementById('case-expand-product');
    const caseStandard = document.getElementById('case-expand-standard');
    const caseNumber = document.getElementById('case-expand-number');
    let activeCaseIdx = -1;
    const caseProducts = isZh ? ['玻璃棉毡 + 铝箔覆面', '橡塑保温管 (NBR/PVC)', '玻璃棉毡 + 橡塑保温管'] : ['Glass Wool Felt + Alu Foil', 'Rubber Plastic Pipe (NBR/PVC)', 'Glass Wool + Rubber Plastic'];
    const caseStandards = isZh ? ['ASTM C612 / GB/T 13350', 'GB/T 17794 / ASTM C534', '定制化管径与壁厚方案'] : ['ASTM C612 / GB/T 13350', 'GB/T 17794 / ASTM C534', 'Custom Diameter & Thickness'];

    caseTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const idx = parseInt(trigger.dataset.caseTrigger ?? '0');
        if (activeCaseIdx === idx) {
          if (casePanel) { casePanel.style.maxHeight = '0'; casePanel.style.opacity = '0'; }
          caseTriggers.forEach(t => t.classList.remove('border-black/12'));
          activeCaseIdx = -1;
          return;
        }
        activeCaseIdx = idx;
        const item = cases[idx];
        if (caseTag) caseTag.textContent = item.tag;
        if (caseTitle) caseTitle.textContent = item.title;
        if (caseScale) caseScale.textContent = item.scale;
        if (caseDetail) caseDetail.textContent = item.detail;
        if (caseProduct) caseProduct.textContent = caseProducts[idx] ?? '';
        if (caseStandard) caseStandard.textContent = caseStandards[idx] ?? '';
        if (caseNumber) caseNumber.textContent = String(idx + 1).padStart(2, '0');
        if (casePanel) { casePanel.style.maxHeight = '600px'; casePanel.style.opacity = '1'; }
        caseTriggers.forEach((t, i) => t.classList.toggle('border-black/12', i === idx));
      });
    });

    /* ── 支持中心：Tab 切换 ── */
    const supportTabs = document.querySelectorAll('[data-support-tab]');
    const supportPanelTitle = document.getElementById('support-panel-title');
    const supportPanelBody = document.getElementById('support-panel-body');
    supportTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = parseInt(tab.dataset.supportTab ?? '0');
        const item = support[idx];
        if (supportPanelTitle) supportPanelTitle.textContent = item.title;
        if (supportPanelBody) supportPanelBody.textContent = item.body;
        supportTabs.forEach((t, i) => {
          t.classList.toggle('border-black/12', i === idx);
          t.classList.toggle('bg-white/85', i === idx);
          t.classList.toggle('border-black/5', i !== idx);
          t.classList.toggle('bg-white/45', i !== idx);
        });
      });
    });

    /* ── 企业博客：点击展开 ── */
    const blogItems = document.querySelectorAll('[data-blog-item]');
    const blogPreviews = isZh
      ? [
          '本文以玻璃棉毡的导热系数为切入点，通过两个典型商业建筑案例的能耗模拟，量化分析低导热材料在全生命周期中的节能效益，并给出设计选型阶段的参数优化建议。',
          'GB 8624、EN 13501-1 与 ASTM E84 三大标准体系在燃烧性能分级上存在显著差异。本文梳理各级别对应关系，帮助出口项目团队在跨标准条件下完成合规材料选型。',
          '冷冻水系统的凝露问题直接影响室内空气质量与吊顶寿命。本文从闭孔结构原理出发，结合管径选型、壁厚计算与胶粘施工三个核心环节，提供可落地的防凝露施工指导。',
        ]
      : [
          'This article uses glass wool thermal conductivity as a starting point, simulating energy consumption differences in two typical commercial buildings to quantify the life-cycle benefits of lower lambda values.',
          'GB 8624, EN 13501-1 and ASTM E84 classification systems differ significantly. This article maps the correspondence between levels to help export project teams select compliant materials across standards.',
          'Condensation in chilled water systems impacts indoor air quality and ceiling durability. This article provides actionable guidance based on closed-cell principles, pipe sizing and adhesive installation.',
        ];
    blogItems.forEach((item) => {
      item.addEventListener('click', () => {
        const idx = parseInt(item.dataset.blogIdx ?? '0');
        const expandDiv = item.querySelector('[style]');
        const preview = item.querySelector('[data-blog-preview]');
        const isOpen = expandDiv && expandDiv.style.maxHeight && expandDiv.style.maxHeight !== '0px' && expandDiv.style.maxHeight !== '0';
        blogItems.forEach((el) => {
          const d = el.querySelector('[style]');
          if (d) { d.style.maxHeight = '0'; d.style.opacity = '0'; }
        });
        if (!isOpen && expandDiv && preview) {
          preview.textContent = blogPreviews[idx] ?? '';
          expandDiv.style.maxHeight = '200px';
          expandDiv.style.opacity = '1';
        }
      });
    });
  }
</script>
