<script define:vars={{ stories: meta.stories }}>
  if (typeof window !== 'undefined') {
    const steps = document.querySelectorAll('[data-home-story-step]');
    const previewTitle = document.getElementById('home-story-title');
    const previewBody = document.getElementById('home-story-body');
    const previewStat = document.getElementById('home-story-stat');
    const previewNumber = document.getElementById('home-story-number');
    const previewNote = document.getElementById('home-story-note');

    const setStory = (step) => {
      if (!previewTitle || !previewBody || !previewStat || !previewNumber || !previewNote) return;
      previewTitle.textContent = step.dataset.storyTitle ?? '';
      previewBody.textContent = step.dataset.storyBody ?? '';
      previewStat.textContent = step.dataset.storyStat ?? '';
      previewNumber.textContent = step.dataset.storyNumber ?? '';
      previewNote.textContent = step.dataset.storyNote ?? '';
      steps.forEach((item) => item.classList.toggle('is-active', item === step));
    };

    if (steps.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setStory(entry.target);
            }
          });
        },
        { threshold: 0.55 }
      );

      steps.forEach((step) => observer.observe(step));
      setStory(steps[0]);
    }
  }
</script>
