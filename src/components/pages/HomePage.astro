        <div class="industrial-frame p-8 md:p-10" data-animate>
          <div class="flex items-center justify-between border-b border-black/6 pb-5">
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-neutral-500">{isZh ? '需求提交' : 'RFQ'}</p>
            <span class="text-[10px] font-semibold uppercase tracking-[0.22em] text-neutral-400">01</span>
          </div>
          <div class="mt-7 grid gap-4">
            <input class="w-full border border-black/8 bg-white/70 px-4 py-3 text-sm text-ink placeholder:text-neutral-500" placeholder={isZh ? '您的姓名或单位名称' : 'Your Name / Company'} />
            <input class="w-full border border-black/8 bg-white/70 px-4 py-3 text-sm text-ink placeholder:text-neutral-500" placeholder={isZh ? '邮箱或联系电话' : 'Email or Phone'} />
            <select class="w-full border border-black/8 bg-white/70 px-4 py-3 text-sm text-ink">
              <option value="">{isZh ? '请选择产品类型' : 'Select Product Type'}</option>
              <option value="glass-wool">{isZh ? '玻璃棉毡' : 'Glass Wool Felt'}</option>
              <option value="rubber-plastic">{isZh ? '橡塑保温管' : 'Rubber Plastic Pipe'}</option>
              <option value="other">{isZh ? '其他 / 综合询价' : 'Other / General Inquiry'}</option>
            </select>
            <textarea class="min-h-[7rem] w-full border border-black/8 bg-white/70 px-4 py-3 text-sm text-ink placeholder:text-neutral-500" placeholder={isZh ? '项目概况与应用需求' : 'Project overview and requirements'}></textarea>
            <button class="inline-flex items-center justify-center bg-steel px-6 py-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-white transition-colors hover:bg-graphite">
