                <h3 class="mt-3 text-base font-semibold leading-[1.5] text-ink transition-colors duration-300 group-hover:text-neutral-700">{item.title}</h3>
                <div class="mt-4 overflow-hidden transition-all duration-700 ease-editorial" style="max-height:0;opacity:0">
                  <div class="border-t border-black/6 pt-4">
                    <p class="text-sm leading-[1.8] text-neutral-600" data-blog-preview></p>
                    <div class="mt-4 flex items-center gap-5">
                      <span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-400">{isZh ? '阅读全文' : 'Read More'} →</span>
                      <span class="text-[10px] text-neutral-300">{isZh ? '约 5 分钟' : '~5 min read'}</span>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <div class="mt-5 flex justify-end">
            <a
              href={getLocalizedPathname(activeLocale, meta.blog.href)}
              class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-ink transition-colors hover:text-neutral-500"
            >
              {meta.blog.action}
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M5 12h14M12 5l7 7-7 7" />
