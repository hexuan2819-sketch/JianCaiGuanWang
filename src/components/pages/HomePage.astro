  <!-- 联系我们 -->
  <section id="contact" class="page-band-soft px-4 py-16 md:px-8 md:py-24 scroll-mt-24">
    <div class="mx-auto max-w-editorial">
      <div class="mb-10" data-animate>
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-neutral-500">{meta.contact.eyebrow}</p>
      </div>
      <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <div data-animate>
          <h2 class="text-fluid-2xl font-semibold tracking-[-0.04em] text-ink">{meta.contact.title}</h2>
          <p class="mt-5 max-w-reading text-fluid-base leading-[1.8] text-neutral-600">{meta.contact.summary}</p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {meta.contact.cards.map((card) => (
              <div class="border border-black/6 px-5 py-5">
