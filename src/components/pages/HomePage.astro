            <p class="mt-4 text-fluid-base leading-[1.8] text-neutral-600">{meta.blog.summary}</p>
          </div>
          <div class="grid gap-3">
            {meta.blog.items.map((item, idx) => (
              <div class="group cursor-pointer industrial-frame industrial-hover-card p-5 transition-all duration-500" data-blog-item data-blog-idx={String(idx)} data-animate>
                <div class="flex items-center justify-between gap-3">
