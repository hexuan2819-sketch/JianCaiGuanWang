---
import Header from '../common/Header.astro';
import Hero from '../sections/Hero.astro';
import ProductModal from '../sections/ProductModal.astro';
import Layout from '../../layouts/Layout.astro';
import { defaultLocale, normalizeLocale, type SupportedLocale } from '../../i18n/config';
import { getLocalizedPathname } from '../../i18n/ui';

export interface Props {
  locale?: SupportedLocale;
}

const activeLocale = normalizeLocale(Astro.props.locale ?? Astro.currentLocale ?? defaultLocale);
const isZh = activeLocale === 'zh';

const meta = isZh
  ? {
      title: '建筑保温材料解决方案',
      description: '聚焦玻璃棉毡与橡塑保温管，构建具有工业权威感与国际审美的工程材料企业站。',
      products: {
        eyebrow: '产品体系',
        title: '产品总览',
        summary: '以玻璃棉毡与橡塑保温管为核心，覆盖建筑围护、暖通空调、工业管道及声学控制等关键应用场景，提供从材料选型到技术响应的完整采购支持。',
        items: [
          {
            id: 'glass-wool-felt',
            title: '玻璃棉毡',
            subtitle: '建筑围护 / 暖通风管 / 工业设备 / 声学控制',
            desc: '以玻璃纤维为基材，通过高速离心成纤与热固粘结工艺制成，具备 A1 级防火、低导热与宽频吸声三重性能。',
            facts: [
              ['防火等级', 'A1 不燃'],
              ['导热系数', '0.032–0.040 W/m·K'],
              ['使用温度', '≤ 350°C'],
              ['吸声性能', 'NRC 0.80–1.00'],
              ['密度范围', '10–96 kg/m³'],
              ['覆面选项', '铝箔 / 玻纤布 / 钢丝网'],
            ],
            href: '/products/glass-wool-felt',
          },
          {
            id: 'rubber-plastic-pipe',
            title: '橡塑保温管',
            subtitle: '冷热水管线 / 机电设备 / 复杂管路系统',
            desc: '以丁腈橡胶与聚氯乙烯为主要原料，经连续发泡工艺成型，闭孔结构有效阻隔水汽渗透，适用于 -40°C 至 +105°C 的管线保温。',
            facts: [
              ['结构', '闭孔发泡'],
              ['导热系数', '≤ 0.034 W/m·K'],
              ['温度范围', '-40 ~ +105°C'],
              ['氧指数', '≥ 32%'],
              ['湿阻因子', '≥ 10000'],
              ['安装方式', '套管 / 板材 / 胶粘'],
            ],
            href: '/products/rubber-plastic-pipe',
          },
        ],
        action: '查看产品详情',
      },
      about: {
        eyebrow: '关于我们',
        title: '以工程标准定义材料价值',
        summary: '我们是一家专注于保温声学材料研发与制造的企业，秉承"以标准定义品质，以交付兑现承诺"的理念，服务全球建筑工程市场。',
        bullets: [
          { icon: '◈', title: '标准体系', body: 'ISO 9001 / ISO 14001 / ISO 45001 三大管理体系认证，产品通过 ASTM、EN、GB 等多国标准检测。' },
          { icon: '◈', title: '制造能力', body: '多条自动化生产线联动，年产能可满足大型基建与工业项目的批量交付需求。' },
          { icon: '◈', title: '技术响应', body: '48 小时内完成技术评审，提供规格书、节点详图、CAD 图块与检测报告等全套技术资料。' },
          { icon: '◈', title: '项目协同', body: '从样品确认、生产排期到物流发运与现场沟通，建立全链条项目交付协同机制。' },
        ],
        stats: [
          { value: '12+', label: '生产线' },
          { value: '20+', label: '出口国家' },
          { value: '500+', label: '服务项目' },
          { value: '48H', label: '技术响应' },
        ],
        action: '了解企业体系',
        href: '/about',
      },
      cases: {
        eyebrow: '工程案例',
        title: '案例分享',
        summary: '我们的材料已广泛应用于商业建筑、工业厂房、交通枢纽与公共设施等多元场景，以可追溯的交付质量赢得项目信任。',
        items: [
          {
            title: '某国际机场航站楼 HVAC 风管保温',
            tag: '交通枢纽',
            scale: '建筑面积 70 万 m²',
            detail: '玻璃棉毡 + 铝箔覆面，满足 A 级防火与低导热双重要求。',
          },
          {
            title: '大型商业综合体暖通保温体系',
            tag: '商业建筑',
            scale: '总冷量 12000 RT',
            detail: '橡塑保温管应用于冷冻水管与冷却水管，闭孔结构长效防凝露。',
          },
          {
            title: '工业厂房机电管线保温项目',
            tag: '工业设施',
            scale: '管线总长 24 km',
            detail: '覆盖蒸汽、热水与冷冻水管线，定制化管径与壁厚方案。',
          },
        ],
        action: '查看案例库',
        href: '/cases/',
      },
      support: {
        eyebrow: '服务支持',
        title: '支持中心',
        summary: '为设计院、顾问公司、总包单位与采购团队提供从选型到交付的全流程技术支持。',
        items: [
          { title: '客户服务', body: '订单跟踪、样品申请与物流协调，专属客服对接项目全过程。', action: '联系客服' },
          { title: '常见问题', body: '产品选型指南、覆面规格说明、施工建议与验收标准参考。', action: '查看 FAQ' },
          { title: '技术支持', body: '节点详图、检测报告、BIM 模型与定制化技术方案输出。', action: '获取支持' },
        ],
        action: '进入支持中心',
        href: '/support/',
      },
      blog: {
        eyebrow: '行业洞察',
        title: '企业博客',
        summary: '以工程视角解读保温材料参数、防火规范趋势与现场施工要点，服务设计与采购决策。',
        items: [
          {
            title: '玻璃棉毡导热系数对 HVAC 系统能耗的影响分析',
            tag: '技术参数',
            date: '2025-03-15',
          },
          {
            title: '建筑防火规范中保温材料燃烧性能分级解读',
            tag: '标准解读',
            date: '2025-02-28',
          },
          {
            title: '橡塑保温管在冷冻水系统中的防凝露设计与施工要点',
            tag: '施工指导',
            date: '2025-01-20',
          },
        ],
        action: '进入博客',
        href: '/blog/',
      },
      contact: {
        eyebrow: '联系方式',
        title: '联系我们',
        summary: '无论您是设计单位、总包企业还是采购商，欢迎留下需求信息，我们将在 48 小时内提供专业的材料建议与技术方案。',
        cards: [
          { label: '企业邮箱', value: 'contact@globalmaterials.com' },
          { label: '服务热线', value: '+86 400 888 0000' },
          { label: '技术响应', value: '48H Technical Review' },
          { label: '工厂地址', value: '中国 · 河北省' },
        ],
        action: '提交需求',
      },
    }
  : {
      title: 'Architectural Insulation Materials',
      description: 'Engineered glass wool and rubber plastic insulation for global construction projects.',
      products: {
        eyebrow: 'Products',
        title: 'Product Overview',
        summary: 'Glass wool felt and rubber plastic insulation pipe for building envelope, HVAC, industrial piping and acoustic control applications, backed by spec-driven technical support.',
        items: [
          {
            id: 'glass-wool-felt',
            title: 'Glass Wool Felt',
            subtitle: 'Envelope / HVAC Duct / Industrial Equipment / Acoustic',
            desc: 'Fiberglass-based insulation manufactured via high-speed centrifugal fiberizing and thermoset bonding, delivering A1 fire rating, low thermal conductivity and broadband acoustic absorption.',
            facts: [
              ['Fire Rating', 'A1 Non-combustible'],
              ['Thermal k', '0.032–0.040 W/m·K'],
              ['Service Temp', '≤ 350°C'],
              ['Acoustic', 'NRC 0.80–1.00'],
              ['Density', '10–96 kg/m³'],
              ['Facing', 'Alu Foil / Glass Cloth / Wire Mesh'],
            ],
            href: '/products/glass-wool-felt',
          },
          {
            id: 'rubber-plastic-pipe',
            title: 'Rubber Plastic Pipe',
            subtitle: 'Chilled Water / MEP Equipment / Complex Piping',
            desc: 'NBR/PVC-based closed-cell elastomeric insulation, continuously foamed for reliable vapor barrier performance across -40°C to +105°C piping applications.',
            facts: [
              ['Structure', 'Closed Cell'],
              ['Thermal k', '≤ 0.034 W/m·K'],
              ['Temp Range', '-40 ~ +105°C'],
              ['Oxygen Index', '≥ 32%'],
              ['μ Factor', '≥ 10,000'],
              ['Format', 'Tube / Sheet / Adhesive'],
            ],
            href: '/products/rubber-plastic-pipe',
          },
        ],
        action: 'View Product Details',
      },
      about: {
        eyebrow: 'About',
        title: 'Engineering Standards Define Material Value',
        summary: 'We are an insulation materials manufacturer dedicated to R&D and production, serving global construction markets with a philosophy of "standards define quality, delivery fulfills commitment."',
        bullets: [
          { icon: '◈', title: 'Certifications', body: 'ISO 9001 / ISO 14001 / ISO 45001 certified. Products tested to ASTM, EN, GB and other international standards.' },
          { icon: '◈', title: 'Manufacturing', body: 'Multiple automated production lines with capacity supporting large-scale infrastructure and industrial project delivery.' },
          { icon: '◈', title: 'Technical Response', body: '48-hour technical review with spec sheets, detail drawings, CAD blocks and test reports.' },
          { icon: '◈', title: 'Project Coordination', body: 'Full-chain delivery coordination from sample approval and production scheduling to logistics and on-site communication.' },
        ],
        stats: [
          { value: '12+', label: 'Production Lines' },
          { value: '20+', label: 'Export Countries' },
          { value: '500+', label: 'Projects Served' },
          { value: '48H', label: 'Tech Response' },
        ],
        action: 'Explore Our System',
        href: '/about',
      },
      cases: {
        eyebrow: 'Projects',
        title: 'Case Studies',
        summary: 'Our materials have been applied across commercial buildings, industrial plants, transport hubs and public facilities, earning trust through traceable delivery quality.',
        items: [
          {
            title: 'International Airport Terminal HVAC Duct Insulation',
            tag: 'Transport Hub',
            scale: '700,000 m² GFA',
            detail: 'Glass wool felt with aluminum foil facing, meeting Class A fire safety and low thermal conductivity requirements.',
          },
          {
            title: 'Large Commercial Complex HVAC Insulation System',
            tag: 'Commercial',
            scale: '12,000 RT Total Capacity',
            detail: 'Rubber plastic pipe insulation on chilled and cooling water lines, long-term condensation control via closed-cell structure.',
          },
          {
            title: 'Industrial Plant MEP Piping Insulation',
            tag: 'Industrial',
            scale: '24 km Total Piping',
            detail: 'Covering steam, hot water and chilled water pipelines with customized diameter and thickness solutions.',
          },
        ],
        action: 'View Case Library',
        href: '/cases/',
      },
      support: {
        eyebrow: 'Support',
        title: 'Support Center',
        summary: 'Full-process technical support from material selection to project delivery for design institutes, consultants, contractors and procurement teams.',
        items: [
          { title: 'Customer Service', body: 'Order tracking, sample requests and logistics coordination with dedicated project support.', action: 'Contact Us' },
          { title: 'FAQs', body: 'Product selection guide, facing specifications, installation guidance and acceptance criteria.', action: 'View FAQs' },
          { title: 'Technical Support', body: 'Detail drawings, test reports, BIM models and customized technical proposals.', action: 'Get Support' },
        ],
        action: 'Open Support Center',
        href: '/support/',
      },
      blog: {
        eyebrow: 'Insights',
        title: 'Blog',
        summary: 'Engineering perspectives on insulation parameters, fire code trends and on-site practices to support design and procurement decisions.',
        items: [
          {
            title: 'How Glass Wool Thermal Conductivity Impacts HVAC Energy Performance',
            tag: 'Technical',
            date: '2025-03-15',
          },
          {
            title: 'Understanding Fire Performance Classifications in Building Codes',
            tag: 'Compliance',
            date: '2025-02-28',
          },
          {
            title: 'Condensation Control for Chilled Water Systems with Elastomeric Insulation',
            tag: 'Installation',
            date: '2025-01-20',
          },
        ],
        action: 'Open Blog',
        href: '/blog/',
      },
      contact: {
        eyebrow: 'Contact',
        title: 'Get In Touch',
        summary: 'Whether you are a design firm, contractor or procurement team, share your project needs and receive professional material guidance within 48 hours.',
        cards: [
          { label: 'Email', value: 'contact@globalmaterials.com' },
          { label: 'Phone', value: '+86 400 888 0000' },
          { label: 'Response', value: '48H Technical Review' },
          { label: 'Factory', value: 'Hebei Province, China' },
        ],
        action: 'Send Request',
      },
    };
---

<Layout title={meta.title} description={meta.description} locale={activeLocale}>
  <Header />
  <Hero />

  <!-- 产品总览 -->
  <section id="products" class="page-band-soft px-4 py-16 md:px-8 md:py-24 scroll-mt-24">
    <div class="mx-auto max-w-editorial">
      <div class="mb-12" data-animate>
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-neutral-500">{meta.products.eyebrow}</p>
        <h2 class="mt-4 text-fluid-2xl font-semibold tracking-[-0.04em] text-ink">{meta.products.title}</h2>
        <p class="mt-5 max-w-reading text-fluid-base leading-[1.8] text-neutral-600">{meta.products.summary}</p>
      </div>
      <div class="grid gap-8 lg:grid-cols-2">
        {meta.products.items.map((item) => (
          <article class="group industrial-frame p-7 md:p-10" data-animate>
            <div class="flex items-center justify-between border-b border-black/6 pb-5">
              <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-neutral-500">{item.id}</p>
              <span class="text-[10px] font-semibold uppercase tracking-[0.22em] text-neutral-400">SPEC</span>
            </div>
            <h3 class="mt-6 text-3xl font-semibold tracking-[-0.035em] text-ink md:text-4xl">{item.title}</h3>
            <p class="mt-3 text-sm font-medium tracking-[0.04em] text-neutral-500">{item.subtitle}</p>
            <p class="mt-5 max-w-[42rem] text-sm leading-[1.8] text-neutral-600">{item.desc}</p>
            <div class="mt-7 grid gap-3 md:grid-cols-3">
              {item.facts.map(([label, value]) => (
                <div class="border border-black/6 bg-white/70 px-4 py-4">
                  <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500">{label}</p>
                  <p class="mt-2 text-sm font-semibold text-ink">{value}</p>
                </div>
              ))}
            </div>
            <div class="mt-7 flex items-center justify-between border-t border-black/6 pt-6">
              <button
                type="button"
                data-product-trigger
                data-product-id={item.id.toUpperCase()}
                data-product-title={item.title}
                data-product-subtitle={item.subtitle}
                data-product-desc={item.desc}
                data-product-href={getLocalizedPathname(activeLocale, item.href)}
                data-product-facts={JSON.stringify(item.facts)}
                class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-ink transition-colors hover:text-neutral-500"
              >
                {meta.products.action}
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </button>
              <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-neutral-400">ISO / ASTM / EN</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 关于我们 -->
  <section id="about" class="page-band px-4 py-16 md:px-8 md:py-24 scroll-mt-24">
    <div class="mx-auto max-w-editorial">
      <div class="mb-10" data-animate>
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-neutral-500">{meta.about.eyebrow}</p>
      </div>
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div data-animate>
          <h2 class="text-fluid-2xl font-semibold tracking-[-0.04em] text-ink">{meta.about.title}</h2>
          <p class="mt-6 max-w-reading text-fluid-base leading-[1.8] text-neutral-600">{meta.about.summary}</p>
          <div class="mt-9 grid gap-5 md:grid-cols-2">
            {meta.about.bullets.map((item) => (
              <div class="flex items-start gap-4">
                <span class="mt-[0.35rem] text-lg text-neutral-400">{item.icon}</span>
                <div>
                  <p class="text-sm font-semibold text-ink">{item.title}</p>
                  <p class="mt-2 text-sm leading-[1.7] text-neutral-600">{item.body}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="mt-9 grid grid-cols-4 gap-4 border-y border-black/6 py-7">
            {meta.about.stats.map((stat) => (
              <div class="text-center">
                <p class="text-2xl font-bold tracking-[-0.03em] text-ink md:text-3xl">{stat.value}</p>
                <p class="mt-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-neutral-500">{stat.label}</p>
              </div>
            ))}
          </div>
          <a
            href={getLocalizedPathname(activeLocale, meta.about.href)}
            class="mt-8 inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-ink transition-colors hover:text-neutral-500"
          >
            {meta.about.action}
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
        <aside class="industrial-frame p-8 md:p-10" data-animate>
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-neutral-500">{isZh ? '资质认证' : 'Credentials'}</p>
          <div class="mt-6 grid gap-4">
            <div class="flex items-center justify-between border border-black/6 px-5 py-5">
              <div>
                <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500">{isZh ? '管理体系' : 'Management'}</p>
                <p class="mt-1 text-sm font-semibold text-ink">ISO 9001 / 14001 / 45001</p>
              </div>
              <span class="text-[10px] text-neutral-400">✓</span>
            </div>
            <div class="flex items-center justify-between border border-black/6 px-5 py-5">
              <div>
                <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500">{isZh ? '产品检测' : 'Testing'}</p>
                <p class="mt-1 text-sm font-semibold text-ink">ASTM / EN / GB / SGS</p>
              </div>
              <span class="text-[10px] text-neutral-400">✓</span>
            </div>
            <div class="flex items-center justify-between border border-black/6 px-5 py-5">
              <div>
                <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500">{isZh ? '出口认证' : 'Export'}</p>
                <p class="mt-1 text-sm font-semibold text-ink">CE / RoHS / REACH</p>
              </div>
              <span class="text-[10px] text-neutral-400">✓</span>
            </div>
            <div class="flex items-center justify-between border border-black/6 px-5 py-5">
              <div>
                <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500">{isZh ? '技术文档' : 'Documents'}</p>
                <p class="mt-1 text-sm font-semibold text-ink">{isZh ? '规格书 / CAD / BIM' : 'Spec / CAD / BIM'}</p>
              </div>
              <span class="text-[10px] text-neutral-400">↓</span>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- 案例分享 -->
  <section id="cases" class="page-band-soft px-4 py-16 md:px-8 md:py-24 scroll-mt-24">
    <div class="mx-auto max-w-editorial">
      <div class="mb-12" data-animate>
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-neutral-500">{meta.cases.eyebrow}</p>
        <h2 class="mt-4 text-fluid-2xl font-semibold tracking-[-0.04em] text-ink">{meta.cases.title}</h2>
        <p class="mt-5 max-w-reading text-fluid-base leading-[1.8] text-neutral-600">{meta.cases.summary}</p>
      </div>
      <div class="grid gap-4 lg:grid-cols-3" data-case-grid>
        {meta.cases.items.map((item, idx) => (
          <button
            type="button"
            data-case-trigger={String(idx)}
            class="group industrial-frame industrial-hover-card p-6 md:p-8 text-left transition-all duration-500"
            data-animate
          >
            <div class="flex items-center justify-between border-b border-black/6 pb-4">
              <span class="text-[10px] font-semibold uppercase tracking-[0.22em] text-neutral-400">{isZh ? '案例' : 'Case'} {String(idx + 1).padStart(2, '0')}</span>
              <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500">{item.tag}</p>
            </div>
            <div class="mt-6 aspect-[16/10] overflow-hidden bg-neutral-100">
              <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-neutral-100 to-neutral-200 transition-transform duration-700 group-hover:scale-105">
                <span class="text-5xl font-light text-neutral-300 transition-colors duration-500 group-hover:text-neutral-400">{idx + 1}</span>
              </div>
            </div>
            <h3 class="mt-6 text-lg font-semibold leading-[1.4] text-ink">{item.title}</h3>
            <p class="mt-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-neutral-500">{item.scale}</p>
            <p class="mt-3 text-sm leading-[1.7] text-neutral-600">{item.detail}</p>
          </button>
        ))}
      </div>
      <div class="mt-4 overflow-hidden transition-all duration-700 ease-editorial" id="case-expand-panel" style="max-height:0;opacity:0">
        <div class="industrial-frame p-8 md:p-12">
