---
import Header from '../common/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { defaultLocale, normalizeLocale, type SupportedLocale } from '../../i18n/config';
import { getLocalizedPathname } from '../../i18n/ui';

export interface SectionItem {
  id: string;
  label: string;
  title: string;
  body: string;
  stat: string;
  specs?: { label: string; value: string }[];
}

export interface Props {
  locale?: SupportedLocale;
  title: string;
  description: string;
  eyebrow: string;
  summary: string;
  anchorItems?: { id: string; label: string }[];
  sections?: SectionItem[];
}

const {
  locale: localeProp,
  title,
  description,
  eyebrow,
  summary,
  anchorItems = [],
  sections = [],
} = Astro.props as Props;

const locale = normalizeLocale(localeProp ?? Astro.currentLocale ?? defaultLocale);
const isZh = locale === 'zh';

const noteLabels = isZh ? ['项目视角', '系统逻辑', '交付结果'] : ['Project View', 'System Logic', 'Delivery'];
const fallbackSpecs = isZh
  ? [{ label: '高标准制造参数', value: 'ISO 9001' }, { label: '稳定可靠的交付体系', value: '48H 响应' }, { label: '严格的技术测试', value: 'ASTM / EN' }]
  : [{ label: 'High Standard', value: 'ISO 9001' }, { label: 'Reliable Delivery', value: '48H Response' }, { label: 'Strict Testing', value: 'ASTM / EN' }];

const renderSections = sections.length ? sections : anchorItems.map((item, index) => ({
  id: item.id,
  label: item.label,
  title: item.label,
  body: isZh
    ? `${item.label} 模块将通过更完整的工程照片、系统节点、参数逻辑与项目结果，构建面向客户与顾问团队的品牌叙事。`
    : `The ${item.label} module can expand with project imagery, system detailing, parameter logic and delivery outcomes.`,
  stat: isZh ? ['300,000m²+ 场景适配', 'ISO / EN / ASTM 对标', '48H 项目响应'][index % 3] : ['300,000m²+ Fit', 'ISO / EN / ASTM', '48H Response'][index % 3],
  specs: fallbackSpecs,
  note: noteLabels[index % 3],
  number: String(index + 1).padStart(2, '0'),
}));
---

<Layout title={title} description={description} locale={locale}>
  <Header />

  <section class="page-band-clear px-4 pb-10 pt-32 md:px-8 md:pb-14 md:pt-36">
    <div class="mx-auto grid max-w-editorial gap-8 lg:grid-cols-[minmax(0,1.1fr)_20rem]">
      <div data-animate-group class="industrial-frame bg-white p-8 md:p-12">
        <p data-animate-item class="industrial-kicker">{eyebrow}</p>
        <h1 data-animate-item class="mt-5 max-w-[12ch] text-fluid-3xl font-display font-semibold leading-[0.95] tracking-display text-ink">
          {title}
        </h1>
        <p data-animate-item class="mt-8 max-w-reading text-fluid-base leading-[1.9] text-neutral-700">
          {summary}
        </p>
      </div>

      <div class="industrial-frame bg-white p-6 md:p-8" data-animate-group>
        <p data-animate-item class="industrial-kicker">{isZh ? '页面导航' : 'On This Page'}</p>
        <div class="mt-5 grid gap-3">
          {anchorItems.length ? (
            anchorItems.map((item, index) => (
              <a
                data-animate-item
                href={`#${item.id}`}
                class="flex items-center justify-between rounded-lg border border-neutral-100 bg-neutral-50 px-4 py-4 text-sm text-neutral-700 transition-colors duration-300 hover:bg-neutral-100"
              >
                <span>{item.label}</span>
                 <span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-neutral-400">{String(index + 1).padStart(2, '0')}</span>
              </a>
            ))
          ) : (
            <div data-animate-item class="rounded-lg border border-neutral-100 bg-neutral-50 px-4 py-4 text-sm text-neutral-700">
              {isZh ? '内容模块将在下一阶段展开。' : 'Content modules will be expanded in the next phase.'}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="page-band px-4 py-12 md:px-8 md:py-16">
    <div class="mx-auto grid max-w-editorial gap-6">
      {renderSections.map((item, index) => {
        const note = item.note || noteLabels[index % 3];
        const number = item.number || String(index + 1).padStart(2, '0');
        const specs = item.specs || fallbackSpecs;
        return (
          <section id={item.id} class="group industrial-frame industrial-hover-card bg-white p-6 md:p-8 lg:p-10" data-animate>
            <div class="grid gap-8 md:grid-cols-[1fr_1fr] lg:grid-cols-[1.2fr_1fr] xl:grid-cols-[1.5fr_1fr]">
              <div class="story-preview-card flex aspect-video w-full items-center justify-center rounded-none">
                <div class="relative z-[1] grid gap-4 text-center transition-transform duration-500 group-hover:scale-[1.03]">
                  <div class="mx-auto h-12 w-12 border border-black/12 bg-white"></div>
                  <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-neutral-500">{note}</p>
                  <span class="text-[clamp(1.4rem,1vw+1rem,2.1rem)] font-semibold tracking-[-0.04em] text-ink">{number}</span>
                </div>
              </div>
              
              <div class="flex flex-col justify-center">
                <p class="industrial-kicker mb-3">{item.label}</p>
                <h3 class="title-balance mb-4 text-2xl font-semibold text-ink md:text-3xl">{item.title}</h3>
                <p class="text-pretty mb-6 max-w-[30rem] text-fluid-base leading-[1.8] text-neutral-700">{item.body}</p>
                
                <ul class="mb-8 grid gap-3">
                  {specs.map((spec) => (
                    <li class="flex items-center justify-between gap-3 text-sm">
                      <span class="text-neutral-600">{spec.label}</span>
                      <span class="font-semibold text-ink">{spec.value}</span>
                    </li>
                  ))}
                </ul>
                
                <div class="mt-auto flex items-center justify-between gap-4 border-t border-black/8 pt-5">
                  <span class="text-[10px] font-semibold uppercase tracking-[0.22em] text-neutral-400">{item.stat}</span>
                  <span class="text-sm text-neutral-500 transition-transform duration-300 group-hover:translate-x-1">→</span>
                </div>
              </div>
            </div>
          </section>
        );
      })}
    </div>
  </section>
</Layout>
