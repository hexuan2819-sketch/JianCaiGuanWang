---
import { defaultLocale, normalizeLocale } from '../../i18n/config';
import { getLocalizedPathname } from '../../i18n/ui';

const locale = normalizeLocale(Astro.currentLocale ?? defaultLocale);
const isZh = locale === 'zh';

const copy = isZh
  ? {
      brand: '工程保温材料系统',
      group: 'GLOBAL MATERIALS GROUP',
      description:
        '聚焦玻璃棉毡、橡塑保温管及系统化工程材料，为建筑围护、暖通机电与工业设施项目提供稳定交付与技术协同。',
      navTitle: '站点导航',
      nav: [
        { label: '首页', href: '/' },
        { label: '产品总览', href: '/products/' },
        { label: '关于我们', href: '/about' },
        { label: '案例分享', href: '/cases/' },
        { label: '支持中心', href: '/support/' },
        { label: '企业博客', href: '/blog/' },
        { label: '联系我们', href: '/contact' },
      ],
      contactTitle: '联系信息',
      contact: ['邮箱：contact@globalmaterials.com', '电话：+86 400 888 0000', '地址：中国 河北省 廊坊市'],
      legalTitle: '备案与说明',
      legal: ['冀ICP备2025000000号-1', '公网安备 13100002000000号', '本网站内容仅作企业展示与商务沟通使用'],
      copyright: 'Global Materials Group. 保留所有权利。',
    }
  : {
      brand: 'ENGINEERED INSULATION SYSTEMS',
      group: 'GLOBAL MATERIALS GROUP',
      description:
        'Focused on glass wool felt, rubber plastic pipe and coordinated engineered materials for building envelope, HVAC, MEP and industrial facilities.',
      navTitle: 'Navigation',
      nav: [
        { label: 'Home', href: '/' },
        { label: 'Products', href: '/products/' },
        { label: 'About', href: '/about' },
        { label: 'Cases', href: '/cases/' },
        { label: 'Support', href: '/support/' },
        { label: 'Blog', href: '/blog/' },
        { label: 'Contact', href: '/contact' },
      ],
      contactTitle: 'Contact',
      contact: ['Email: contact@globalmaterials.com', 'Phone: +86 400 888 0000', 'Address: Langfang, Hebei, China'],
      legalTitle: 'Filing & Notice',
      legal: ['Ji ICP No.2025000000-1', 'PSB Registration 13100002000000', 'This website is for corporate presentation and business communication only'],
      copyright: 'Global Materials Group. All rights reserved.',
    };
---

<footer id="corporate-footer" class="border-t border-white/8 bg-black/80 px-4 py-8 md:px-8 md:py-10 backdrop-blur-md">
  <div class="mx-auto max-w-editorial">
    <div class="grid gap-8 md:grid-cols-3 xl:gap-12" data-animate-group>
      <div data-animate-item>
        <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-white/40">{copy.group}</p>
        <p class="mt-3 text-sm font-semibold text-white/90">{copy.brand}</p>
        <p class="text-pretty mt-3 max-w-[28rem] text-xs leading-[1.7] text-white/45">{copy.description}</p>
      </div>

      <div data-animate-item>
        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-white/35">{copy.navTitle}</p>
        <ul class="mt-3 grid gap-1.5 text-xs text-white/50">
          {copy.nav.map((item) => (
            <li>
              <a href={getLocalizedPathname(locale, item.href)} class="transition-colors duration-300 hover:text-white/80">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div data-animate-item>
        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-white/35">{copy.contactTitle}</p>
        <ul class="mt-3 grid gap-1.5 text-xs leading-[1.7] text-white/50">
          {copy.contact.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <p class="mt-5 text-[10px] font-semibold uppercase tracking-[0.2em] text-white/35">{copy.legalTitle}</p>
        <ul class="mt-2 grid gap-1.5 text-xs leading-[1.7] text-white/35">
          {copy.legal.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-white/8 pt-5 text-[10px] font-medium tracking-[0.1em] text-white/30 md:flex-row md:items-center md:justify-between" data-animate>
      <span>© {new Date().getFullYear()} {copy.copyright}</span>
      <span>{isZh ? '静态多语言架构' : 'Static multilingual architecture'}</span>
    </div>
  </div>
</footer>
