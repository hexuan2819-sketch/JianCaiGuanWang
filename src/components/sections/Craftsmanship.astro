---
import { defaultLocale, normalizeLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const image =
  'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=2070&auto=format&fit=crop';
const locale = normalizeLocale(Astro.currentLocale ?? defaultLocale);
const t = useTranslations(locale);
---

<section id="craftsmanship" class="relative flex min-h-[100svh] w-full flex-col justify-center overflow-hidden bg-black lg:h-[100svh]">
  <!-- Full-bleed Background with Parallax -->
  <div id="craft-stage" class="absolute inset-0 z-0 h-full w-full overflow-hidden">
    <img src={image} alt={t('craftsmanship.imageAlt')} loading="lazy" decoding="async" class="absolute inset-0 h-[110%] w-[110%] object-cover -top-[5%] -left-[5%] transition-transform duration-700 ease-out will-change-transform transform-gpu" id="craft-image" />
    
    <!-- Cinematic Dark Gradients -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#050505] via-transparent to-[#050505] opacity-90"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-transparent to-[#050505] opacity-80"></div>
    <div class="absolute inset-0 bg-black/50 backdrop-blur-[2px]"></div>
    <div class="absolute inset-0 blend-noise opacity-40"></div>
  </div>
  
  <!-- Seamless Edge Masks for all directions blending -->
  <div class="seamless-edge-mask-top"></div>
  <div class="seamless-edge-mask-bottom"></div>
  <div class="seamless-edge-mask-left"></div>
  <div class="seamless-edge-mask-right"></div>

  <!-- Content Container -->
  <div class="relative z-10 mx-auto flex w-full max-w-[1800px] flex-col items-center justify-center px-4 text-center md:px-8">
    <div data-animate-group class="glass-cinematic flex flex-col items-center justify-center border border-white/10 bg-black/25 px-6 py-10 md:px-12 md:py-14">
      <!-- Section Label -->
      <div data-animate-item class="flex items-center justify-center gap-4 mb-8">
        <div class="h-px w-8 bg-[#cfa878]/40"></div>
        <span class="text-[10px] font-light tracking-[0.4em] text-[#cfa878] uppercase">{t('craftsmanship.sectionLabel')}</span>
        <div class="h-px w-8 bg-[#cfa878]/40"></div>
      </div>

      <!-- Headlines -->
      <h2 data-animate-item class="font-serif text-[clamp(2.5rem,6vw,5rem)] font-normal leading-[1.1] text-white mb-2 tracking-wide drop-shadow-2xl">
        {t('craftsmanship.title')}
      </h2>
      <h3 data-animate-item class="font-serif text-[clamp(2rem,4.5vw,4rem)] font-normal italic leading-[1.1] text-neutral-400 mb-10 tracking-wide drop-shadow-xl">
        {t('craftsmanship.subtitle')}
      </h3>

      <!-- Body Copy -->
      <p data-animate-item class="max-w-[800px] text-sm font-light leading-8 tracking-[0.08em] text-neutral-300 md:text-base md:leading-9 mb-16 md:mb-24">
        {t('craftsmanship.body')}
      </p>

      <!-- Metrics Row -->
      <div data-animate-item class="flex flex-col items-center justify-center gap-12 md:flex-row md:gap-16 lg:gap-24">
        <div class="flex flex-col items-center group">
          <span class="font-serif text-4xl md:text-5xl font-normal text-white mb-3 transition-transform duration-500 group-hover:-translate-y-1">{t('craftsmanship.metrics.first.value')}</span>
          <span class="text-[10px] tracking-[0.25em] text-neutral-500 uppercase">{t('craftsmanship.metrics.first.label')}</span>
        </div>
        
        <div class="hidden h-16 w-px bg-white/10 md:block"></div>
        <div class="block h-px w-16 bg-white/10 md:hidden"></div>
        
        <div class="flex flex-col items-center group">
          <span class="font-serif text-4xl md:text-5xl font-normal text-[#cfa878] mb-3 transition-transform duration-500 group-hover:-translate-y-1 drop-shadow-[0_0_15px_rgba(207,168,120,0.4)]">{t('craftsmanship.metrics.second.value')}</span>
          <span class="text-[10px] tracking-[0.25em] text-neutral-500 uppercase">{t('craftsmanship.metrics.second.label')}</span>
        </div>
        
        <div class="hidden h-16 w-px bg-white/10 md:block"></div>
        <div class="block h-px w-16 bg-white/10 md:hidden"></div>
        
        <div class="flex flex-col items-center group">
          <span class="font-serif text-4xl md:text-5xl font-normal text-white mb-3 transition-transform duration-500 group-hover:-translate-y-1">{t('craftsmanship.metrics.third.value')}</span>
          <span class="text-[10px] tracking-[0.25em] text-neutral-500 uppercase">{t('craftsmanship.metrics.third.label')}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    const stage = document.getElementById('craftsmanship');
    const image = document.getElementById('craft-image');

    const prefersHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (stage && image && prefersHover) {
      let ticking = false;
      let isVisible = false;

      const observer = new IntersectionObserver((entries) => {
        isVisible = entries[0].isIntersecting;
      }, { threshold: 0 });
      observer.observe(stage);

      stage.addEventListener('mousemove', (event) => {
        if (!isVisible || ticking) return;

        window.requestAnimationFrame(() => {
          const rect = stage.getBoundingClientRect();
          const x = event.clientX - rect.left;
          const y = event.clientY - rect.top;
          
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          
          const moveX = ((x - centerX) / centerX) * -15; // Max 15px movement
          const moveY = ((y - centerY) / centerY) * -15;
          
          // Subtle Parallax for Background Image
          image.style.transform = `translate3d(${moveX}px, ${moveY}px, 0) scale(1.05)`;
          
          ticking = false;
        });
        
        ticking = true;
      }, { passive: true });

      stage.addEventListener('mouseleave', () => {
        if (!isVisible) return;
        window.requestAnimationFrame(() => {
          image.style.transform = 'translate3d(0, 0, 0) scale(1.05)';
        });
      });
    }
  }
</script>
