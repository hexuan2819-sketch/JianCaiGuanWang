---
const slides = [
  {
    title: '深耕中东与中亚，服务全球地标',
    copy: '以迪拜、利雅得、塔什干与阿拉木图为关键节点，构建覆盖原材采购、工厂制造、国际物流与项目交付的连续服务链路。让地标建筑在复杂供应条件下依然保持稳定推进。',
    metricA: '26+',
    metricALabel: '核心供应节点',
    metricB: '72h',
    metricBLabel: '快速响应机制',
    image: 'https://images.unsplash.com/photo-1511818966892-d7d671e672a2?q=80&w=1974&auto=format&fit=crop',
  },
  {
    title: '从城市天际线到项目落地，建立跨区域协同',
    copy: '针对酒店、商业综合体与总部办公项目，我们将样板确认、批次控制与节点交付整合为同一套执行语言，减少跨国协作中的信息损耗。',
    metricA: '14',
    metricALabel: '跨境协作项目组',
    metricB: '100%',
    metricBLabel: '关键节点追踪',
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=1974&auto=format&fit=crop',
  },
  {
    title: '让材料能力与建筑叙事在同一画面里发生',
    copy: '无论是高端私宅还是公共空间，我们更关注材料如何参与空间叙事，而非只承担装饰角色。每一次供货，最终都指向更完整的项目气质与体验。',
    metricA: '200+',
    metricALabel: '项目交付经验',
    metricB: 'A+',
    metricBLabel: '客户复购口碑',
    image: 'https://images.unsplash.com/photo-1518005020951-eccb494ad742?q=80&w=2070&auto=format&fit=crop',
  },
];
---

<section id="global-vision" class="relative flex min-h-[100svh] w-full flex-col justify-center bg-black">
  <div id="vision-carousel" class="absolute inset-0 z-0 h-full w-full overflow-hidden">
    {slides.map((slide, index) => (
      <div
        class={`vision-slide absolute inset-0 h-full w-full transition-all duration-1000 ease-[cubic-bezier(0.25,1,0.5,1)] ${index === 0 ? 'opacity-100 scale-100 translate-z-0' : 'opacity-0 scale-95 -translate-z-20'}`}
      >
        <img
          src={slide.image}
          alt={slide.title}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-10000 ease-linear scale-110 will-change-transform transform-gpu"
        />
        
        <!-- Cinematic Dark Gradients -->
        <div class="absolute inset-0 bg-gradient-to-b from-[#050505] via-transparent to-[#050505] opacity-90"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-transparent to-[#050505] opacity-80"></div>
        <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]"></div>
        
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_30%,rgba(255,255,255,0.03),transparent_22%)]"></div>
        <div class="absolute inset-0 blend-noise opacity-45"></div>
      </div>
    ))}

    <!-- Seamless Edge Masks for all directions blending -->
    <div class="seamless-edge-mask-top"></div>
    <div class="seamless-edge-mask-bottom"></div>
    <div class="seamless-edge-mask-left"></div>
    <div class="seamless-edge-mask-right"></div>
  </div>

  <div class="relative z-10 mx-auto flex w-full max-w-[1800px] flex-col items-center justify-center px-4 py-16 md:px-8 h-full min-h-[100svh]">
    <!-- Dynamic Background Glow for Content -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vh] bg-[#cfa878]/5 rounded-full blur-[120px] mix-blend-screen animate-pulse pointer-events-none"></div>

    <div class="flex flex-col items-center justify-center text-center max-w-[1000px] mx-auto z-10 w-full flex-1" data-animate-group>
      <div data-animate-item class="flex items-center justify-center gap-4 mb-8 mt-auto">
        <div class="h-px w-8 bg-[#cfa878]/40"></div>
        <span class="text-[10px] font-light tracking-[0.4em] text-[#cfa878] uppercase">01 / GLOBAL VISION</span>
        <div class="h-px w-8 bg-[#cfa878]/40"></div>
      </div>
      
      <h2 id="vision-title" data-animate-item class="font-serif text-[clamp(2.5rem,5.5vw,5.5rem)] font-normal leading-[1.1] text-white mb-6 tracking-wide drop-shadow-2xl max-w-[16ch]">
        {slides[0].title}
      </h2>
      
      <p id="vision-copy" data-animate-item class="max-w-[42rem] text-sm font-light leading-8 tracking-[0.08em] text-neutral-300 md:text-base md:leading-9 mb-16 md:mb-20 drop-shadow-lg">
        {slides[0].copy}
      </p>

      <div class="flex flex-col items-center justify-center gap-12 md:flex-row md:gap-20 lg:gap-32 w-full mb-auto" data-animate-item>
        <div class="flex flex-col items-center group">
          <span id="vision-metric-a" class="font-serif text-4xl md:text-5xl font-normal text-white mb-3 transition-transform duration-500 group-hover:-translate-y-1">{slides[0].metricA}</span>
          <span id="vision-metric-a-label" class="text-[10px] tracking-[0.25em] text-neutral-500 uppercase">{slides[0].metricALabel}</span>
        </div>
        
        <div class="hidden h-16 w-px bg-white/10 md:block"></div>
        <div class="block h-px w-16 bg-white/10 md:hidden"></div>
        
        <div class="flex flex-col items-center group">
          <span id="vision-metric-b" class="font-serif text-4xl md:text-5xl font-normal text-[#cfa878] mb-3 transition-transform duration-500 group-hover:-translate-y-1 drop-shadow-[0_0_15px_rgba(207,168,120,0.4)]">{slides[0].metricB}</span>
          <span id="vision-metric-b-label" class="text-[10px] tracking-[0.25em] text-neutral-500 uppercase">{slides[0].metricBLabel}</span>
        </div>
      </div>
    </div>

    <!-- Carousel Controls fixed at bottom of container -->
    <div class="pointer-events-auto w-full flex items-center justify-between pb-8 pt-12">
      <div class="flex items-center justify-center rounded-full border border-[#cfa878]/30 bg-black/40 px-6 py-3 backdrop-blur-md">
        <span id="vision-index" class="font-serif text-sm tracking-[0.3em] text-[#cfa878]">01 / 03</span>
      </div>
      <div class="flex gap-4">
        <button id="vision-prev" class="group flex h-12 w-12 items-center justify-center rounded-full border border-[#cfa878]/30 bg-black/40 backdrop-blur-md transition-all duration-300 hover:scale-110 hover:border-[#cfa878] hover:bg-black/60 md:h-14 md:w-14">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[#cfa878] transition-transform group-hover:-translate-x-1"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button id="vision-next" class="group flex h-12 w-12 items-center justify-center rounded-full border border-[#cfa878]/30 bg-black/40 backdrop-blur-md transition-all duration-300 hover:scale-110 hover:border-[#cfa878] hover:bg-black/60 md:h-14 md:w-14">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[#cfa878] transition-transform group-hover:translate-x-1"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>
<script>
  if (typeof window !== 'undefined') {
    const slideData = [
      {
        title: '深耕中东与中亚，服务全球地标',
        copy: '以迪拜、利雅得、塔什干与阿拉木图为关键节点，构建覆盖原材采购、工厂制造、国际物流与项目交付的连续服务链路。让地标建筑在复杂供应条件下依然保持稳定推进。',
        metricA: '26+',
        metricALabel: '核心供应节点',
        metricB: '72h',
        metricBLabel: '快速响应机制',
        note: '从关键城市节点出发，建立更稳定的跨境材料履约系统。',
        mode: '供应、深化、清关与交付在同一时间轴下协同。',
      },
      {
        title: '从城市天际线到项目落地，建立跨区域协同',
        copy: '针对酒店、商业综合体与总部办公项目，我们将样板确认、批次控制与节点交付整合为同一套执行语言，减少跨国协作中的信息损耗。',
        metricA: '14',
        metricALabel: '跨境协作项目组',
        metricB: '100%',
        metricBLabel: '关键节点追踪',
        note: '跨国协同不只靠响应速度，更依赖标准化的项目界面与节点判断。',
        mode: '样板先行、批次复核、节点交付三位一体推进。',
      },
      {
        title: '让材料能力与建筑叙事在同一画面里发生',
        copy: '无论是高端私宅还是公共空间，我们更关注材料如何参与空间叙事，而非只承担装饰角色。每一次供货，最终都指向更完整的项目气质与体验。',
        metricA: '200+',
        metricALabel: '项目交付经验',
        metricB: 'A+',
        metricBLabel: '客户复购口碑',
        note: '材料不只是被选择，更应该主动参与空间叙事的建立。',
        mode: '从选材到现场表现，以审美与工程双线同步推进。',
      },
    ];
    const slides = Array.from(document.querySelectorAll('#vision-carousel .vision-slide'));
    const indexLabel = document.getElementById('vision-index');
    const prev = document.getElementById('vision-prev');
    const next = document.getElementById('vision-next');
    const title = document.getElementById('vision-title');
    const copy = document.getElementById('vision-copy');
    const metricA = document.getElementById('vision-metric-a');
    const metricALabel = document.getElementById('vision-metric-a-label');
    const metricB = document.getElementById('vision-metric-b');
    const metricBLabel = document.getElementById('vision-metric-b-label');

    if (slides.length && indexLabel && prev && next && title && copy && metricA && metricALabel && metricB && metricBLabel) {
      let active = 0;
      let timer: ReturnType<typeof setInterval> | undefined;

      const render = (index: number) => {
        active = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          if (i === active) {
            slide.classList.remove('opacity-0', 'scale-95', '-translate-z-20');
            slide.classList.add('opacity-100', 'scale-100', 'translate-z-0');
          } else {
            slide.classList.remove('opacity-100', 'scale-100', 'translate-z-0');
            slide.classList.add('opacity-0', 'scale-95', '-translate-z-20');
          }
        });
        indexLabel.textContent = `0${active + 1} / 0${slides.length}`;
        title.textContent = slideData[active].title;
        copy.textContent = slideData[active].copy;
        metricA.textContent = slideData[active].metricA;
        metricALabel.textContent = slideData[active].metricALabel;
        metricB.textContent = slideData[active].metricB;
        metricBLabel.textContent = slideData[active].metricBLabel;
      };

      const autoplay = () => {
        clearInterval(timer);
        timer = setInterval(() => render(active + 1), 4200);
      };

      prev.addEventListener('click', () => {
        render(active - 1);
        autoplay();
      });
      next.addEventListener('click', () => {
        render(active + 1);
        autoplay();
      });

      autoplay();
    }
  }
</script>
