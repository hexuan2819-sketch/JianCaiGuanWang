---
const slides = [
  {
    title: '木地板系统',
    copy: '适用于套房、会所与长住空间，强调脚感、拼缝稳定与耐用层表现。',
    image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?q=80&w=2070&auto=format&fit=crop'
  },
  {
    title: '墙面木饰面',
    copy: '用于背景墙、走廊与接待区，兼顾节点收口、灯槽整合与大面积节奏控制。',
    image: 'https://images.unsplash.com/photo-1518005020951-eccb494ad742?q=80&w=2070&auto=format&fit=crop'
  },
  {
    title: '定制家具面层',
    copy: '延伸到柜门、门套与固定家具，让空间语言在细部层面保持一致。',
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop'
  }
];
---

<section id="category-wood" class="flex min-h-[100svh] w-full flex-col justify-center bg-transparent py-4 md:py-6 lg:h-[100svh]">
  <div class="mx-auto flex min-h-[calc(100svh-2rem)] w-full max-w-[1800px] flex-col px-4 md:min-h-[calc(100svh-3rem)] md:px-8 lg:h-full lg:min-h-0">
    <div class="mb-6 flex flex-col gap-4 px-2 sm:px-4 md:mb-8 md:flex-row md:items-end md:justify-between">
      <div>
        <span class="text-xs font-light tracking-[0.4em] text-[#cfa878]">03 / 王牌品类 02</span>
        <h2 class="mt-4 font-serif text-3xl font-normal text-white tracking-[0.15em] sm:text-4xl sm:tracking-widest">温润木艺</h2>
      </div>
      <p class="max-w-[400px] text-sm font-light leading-8 tracking-wider text-neutral-300 md:text-right">
        强调天然纹理、色差控制与触觉质感之间的平衡，让空间在深色背景中仍保有温度。
      </p>
    </div>

    <div class="flex flex-1 flex-col gap-4 overflow-hidden md:flex-row md:gap-6" id="wood-gallery">
      {slides.map((slide, index) => (
        <div 
          class={`wood-panel group relative overflow-hidden rounded-[1.75rem] border border-[#cfa878]/20 bg-black/40 transition-[flex,min-height,transform] duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] cursor-pointer md:h-full md:rounded-[2.5rem] ${index === 0 ? 'min-h-[22rem] md:flex-[3]' : 'min-h-[10rem] md:flex-[1]'}`}
          data-index={index}
          tabindex="0"
        >
          <img src={slide.image} alt={slide.title} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 group-hover:scale-105 will-change-transform transform-gpu" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-90 transition-opacity duration-500 group-hover:opacity-100"></div>
          
          <div class="absolute bottom-0 left-0 w-full p-6 sm:p-8 md:p-10">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-full mb-6 border border-[#cfa878]/30 bg-black/40 backdrop-blur-md">
              <span class="font-serif text-lg font-normal text-[#cfa878]">0{index + 1}</span>
            </div>
            
            <h3 class="mb-4 font-serif text-3xl font-normal text-white sm:text-4xl md:mb-6 md:whitespace-nowrap">{slide.title}</h3>
            
            <div class={`wood-content overflow-hidden transition-all duration-700 ${index === 0 ? 'max-h-[150px] opacity-100' : 'max-h-0 opacity-0'}`}>
              <p class="max-w-[400px] text-sm font-light leading-8 tracking-[0.1em] text-neutral-300 md:text-base">
                {slide.copy}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.wood-panel'));
    const contents = Array.from(document.querySelectorAll<HTMLElement>('.wood-content'));
    const hoverMedia = window.matchMedia('(hover: hover) and (pointer: fine)');

    const activatePanel = (activeIndex: number) => {
      panels.forEach((p, i) => {
        p.classList.remove('min-h-[22rem]', 'md:flex-[3]');
        p.classList.add('min-h-[10rem]', 'md:flex-[1]');
        contents[i]?.classList.remove('max-h-[100px]', 'opacity-100');
        contents[i]?.classList.add('max-h-0', 'opacity-0');
      });

      const activePanel = panels[activeIndex];
      const activeContent = contents[activeIndex];

      activePanel?.classList.remove('min-h-[10rem]', 'md:flex-[1]');
      activePanel?.classList.add('min-h-[22rem]', 'md:flex-[3]');
      activeContent?.classList.remove('max-h-0', 'opacity-0');
      activeContent?.classList.add('max-h-[100px]', 'opacity-100');
    };

    panels.forEach((panel, index) => {
      if (hoverMedia.matches) {
        panel.addEventListener('mouseenter', () => activatePanel(index));
      }

      panel.addEventListener('click', () => activatePanel(index));
      panel.addEventListener('focus', () => activatePanel(index));
    });

    activatePanel(0);
  }
</script>
