---
const slides = [
  {
    title: '木地板系统',
    copy: '适用于套房、会所与长住空间，强调脚感、拼缝稳定与耐用层表现。',
    image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?q=80&w=2070&auto=format&fit=crop'
  },
  {
    title: '墙面木饰面',
    copy: '用于背景墙、走廊与接待区，兼顾节点收口、灯槽整合与大面积节奏控制。',
    image: 'https://images.unsplash.com/photo-1518005020951-eccb494ad742?q=80&w=2070&auto=format&fit=crop'
  },
  {
    title: '定制家具面层',
    copy: '延伸到柜门、门套与固定家具，让空间语言在细部层面保持一致。',
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop'
  }
];
---

<section id="category-wood" class="h-[100svh] w-full flex flex-col justify-center bg-transparent py-6">
  <div class="mx-auto w-full max-w-[1800px] px-4 md:px-8 h-full flex flex-col">
    <div class="flex items-center justify-between mb-6 px-4">
      <div>
        <span class="text-[10px] font-light tracking-[0.34em] text-neutral-400">03 / 王牌品类 02</span>
        <h2 class="mt-2 font-display text-3xl font-light text-white tracking-widest">温润木艺</h2>
      </div>
      <p class="max-w-[400px] text-xs font-light leading-6 tracking-wider text-neutral-300 text-right">
        强调天然纹理、色差控制与触觉质感之间的平衡，让空间在深色背景中仍保有温度。
      </p>
    </div>

    <div class="flex-1 flex gap-4 overflow-hidden" id="wood-gallery">
      {slides.map((slide, index) => (
        <div 
          class={`wood-panel group relative h-full overflow-hidden rounded-[2rem] border border-white/10 transition-[flex] duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] cursor-pointer ${index === 0 ? 'flex-[3]' : 'flex-[1]'}`}
        >
          <img src={slide.image} alt={slide.title} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 group-hover:scale-105 will-change-transform transform-gpu" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-80 transition-opacity duration-500 group-hover:opacity-100"></div>
          
          <div class="absolute bottom-0 left-0 p-8 w-full">
            <div class="glass-cinematic inline-flex h-12 w-12 items-center justify-center rounded-full mb-6">
              <span class="text-sm font-light text-white">0{index + 1}</span>
            </div>
            
            <h3 class="font-display text-3xl font-light text-white mb-4 whitespace-nowrap">{slide.title}</h3>
            
            <div class={`wood-content overflow-hidden transition-all duration-700 ${index === 0 ? 'max-h-[100px] opacity-100' : 'max-h-0 opacity-0'}`}>
              <p class="text-sm font-light leading-7 tracking-[0.08em] text-neutral-200 max-w-[400px]">
                {slide.copy}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    const panels = document.querySelectorAll('.wood-panel');
    const contents = document.querySelectorAll('.wood-content');

    panels.forEach((panel, index) => {
      panel.addEventListener('mouseenter', () => {
        panels.forEach((p, i) => {
          p.classList.remove('flex-[3]');
          p.classList.add('flex-[1]');
          contents[i].classList.remove('max-h-[100px]', 'opacity-100');
          contents[i].classList.add('max-h-0', 'opacity-0');
        });
        
        panel.classList.remove('flex-[1]');
        panel.classList.add('flex-[3]');
        contents[index].classList.remove('max-h-0', 'opacity-0');
        contents[index].classList.add('max-h-[100px]', 'opacity-100');
      });
    });
  }
</script>
