---
const cards = [
  {
    title: '商业地产',
    copy: '以统一材料语言完成公区、电梯厅、立面与导视界面的整体串联，建立项目气质。',
    tag: '旗舰叙事',
    image: 'https://images.unsplash.com/photo-1494526585095-c41746248156?q=80&w=1974&auto=format&fit=crop',
    shape: 'polygon(20% 0%, 100% 0, 100% 80%, 80% 100%, 0 100%, 0% 20%)'
  },
  {
    title: '星级酒店',
    copy: '兼顾高频使用与空间仪式感，控制批次稳定、触感细节与夜间光影层次。',
    tag: '高频运营',
    image: 'https://images.unsplash.com/photo-1445019980597-93fa8acb246c?q=80&w=2070&auto=format&fit=crop',
    shape: 'polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%)'
  },
  {
    title: '高端私宅',
    copy: '围绕厅、厨、卧与卫浴的连续体验，建立克制而长期耐看的居住表情。',
    tag: '私宅定制',
    image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?q=80&w=2070&auto=format&fit=crop',
    shape: 'polygon(10% 0, 90% 0, 100% 50%, 90% 100%, 10% 100%, 0 50%)'
  },
  {
    title: '文化会所',
    copy: '通过石材、木艺与金属的复合搭配，塑造带有记忆点的安静空间。',
    tag: '文化静场',
    image: 'https://images.unsplash.com/photo-1511818966892-d7d671e672a2?q=80&w=2070&auto=format&fit=crop',
    shape: 'polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%)'
  },
  {
    title: '办公总部',
    copy: '面向企业形象与效率空间，兼顾前台辨识度、会议区稳定感与动线秩序。',
    tag: '总部形象',
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop',
    shape: 'polygon(0 0, 80% 0, 100% 20%, 100% 100%, 20% 100%, 0 80%)'
  },
];
---

<section id="bento-scenarios" class="h-[100svh] w-full flex flex-col justify-center bg-transparent py-6 relative">
  <div class="mx-auto w-full max-w-[1800px] px-4 md:px-8 h-full flex flex-col relative z-10">
    <div class="flex items-center justify-between mb-10 px-4">
      <div>
        <span class="text-[10px] font-light tracking-[0.34em] text-neutral-400">04 / 应用场景</span>
        <h2 class="mt-2 font-display text-3xl font-light text-white tracking-widest">在复杂项目中，保持统一叙事</h2>
      </div>
      <p class="max-w-[400px] text-xs font-light leading-6 tracking-wider text-neutral-300 text-right">
        不同场景拥有不同尺度、预算与耐久要求。我们用同一套供应与深化方法，让空间拥有独立表情。
      </p>
    </div>

    <div class="flex-1 w-full h-full grid grid-cols-1 md:grid-cols-3 grid-rows-2 gap-4 md:gap-6 px-4" id="bento-grid">
      {cards.map((card, index) => (
        <button
          class={`bento-card group relative overflow-hidden rounded-[2rem] border border-white/10 transition-all duration-500 hover:border-white/30 hover:shadow-[0_0_40px_rgba(255,255,255,0.1)] ${index === 0 ? 'md:col-span-2' : ''} ${index === 3 ? 'md:col-span-1' : ''} will-change-transform transform-gpu`}
          data-index={index}
          aria-label={card.title}
        >
          <img src={card.image} alt={card.title} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 group-hover:scale-110 will-change-transform transform-gpu" />
          <div class="absolute inset-0 bg-black/40 transition-all duration-500 group-hover:bg-black/20"></div>
          
          <div class="absolute bottom-0 left-0 p-8 text-left w-full bg-gradient-to-t from-black/80 to-transparent">
            <span class="inline-block px-3 py-1 mb-3 rounded-full border border-white/20 bg-white/10 backdrop-blur-md text-[10px] tracking-widest text-white/90">
              {card.tag}
            </span>
            <h3 class="font-display text-2xl md:text-3xl font-light text-white mb-2 transform transition-transform duration-500 group-hover:-translate-y-1">{card.title}</h3>
            <p class="text-sm font-light text-neutral-300 opacity-0 transform translate-y-4 transition-all duration-500 group-hover:opacity-100 group-hover:translate-y-0 line-clamp-2">
              {card.copy}
            </p>
          </div>
        </button>
      ))}
    </div>
  </div>

  <!-- Expanded Overlay -->
  <div id="scenario-overlay" class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-2xl opacity-0 pointer-events-none transition-opacity duration-700">
    <button id="scenario-close" class="absolute top-8 right-8 z-50 h-12 w-12 rounded-full border border-white/20 bg-white/5 flex items-center justify-center text-white hover:bg-white/20 transition-colors">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    
    <div class="relative w-full max-w-[1400px] h-[80vh] mx-4 rounded-[2rem] overflow-hidden border border-white/10 shadow-2xl flex flex-col md:flex-row transform scale-95 transition-transform duration-700" id="scenario-overlay-content">
      <div class="w-full md:w-1/2 h-1/2 md:h-full relative">
        <img id="scenario-expanded-img" src="" alt="" class="absolute inset-0 h-full w-full object-cover" />
      </div>
      <div class="w-full md:w-1/2 h-1/2 md:h-full bg-neutral-900 flex flex-col justify-center p-10 md:p-20 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
        <span id="scenario-expanded-tag" class="text-xs tracking-[0.3em] text-neutral-400 mb-6"></span>
        <h3 id="scenario-expanded-title" class="font-display text-4xl md:text-5xl font-light text-white mb-8"></h3>
        <p id="scenario-expanded-copy" class="text-base font-light leading-9 tracking-[0.08em] text-neutral-300 max-w-md"></p>
      </div>
    </div>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    const cardsData = [
      {
        title: '商业地产',
        copy: '以统一材料语言完成公区、电梯厅、立面与导视界面的整体串联，建立项目气质。让前场识别度、背景墙连续性与公共动线中的耐用秩序得到完美体现。',
        tag: '旗舰叙事',
        image: 'https://images.unsplash.com/photo-1494526585095-c41746248156?q=80&w=1974&auto=format&fit=crop'
      },
      {
        title: '星级酒店',
        copy: '兼顾高频使用与空间仪式感，控制批次稳定、触感细节与夜间光影层次。从大堂到套房，强化石材、木艺与金属之间的层次过渡。',
        tag: '高频运营',
        image: 'https://images.unsplash.com/photo-1445019980597-93fa8acb246c?q=80&w=2070&auto=format&fit=crop'
      },
      {
        title: '高端私宅',
        copy: '围绕厅、厨、卧与卫浴的连续体验，建立克制而长期耐看的居住表情。通过细部收口和表面触感，让日常空间拥有静水深流的力量。',
        tag: '私宅定制',
        image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?q=80&w=2070&auto=format&fit=crop'
      },
      {
        title: '文化会所',
        copy: '通过石材、木艺与金属的复合搭配，塑造带有记忆点的安静空间。以更安静的材质关系控制情绪，让会所空间兼具停留感与仪式感。',
        tag: '文化静场',
        image: 'https://images.unsplash.com/photo-1511818966892-d7d671e672a2?q=80&w=2070&auto=format&fit=crop'
      },
      {
        title: '办公总部',
        copy: '面向企业形象与效率空间，兼顾前台辨识度、会议区稳定感与动线秩序。以简洁但不空洞的材料逻辑，为企业品牌建立长期可识别的办公界面。',
        tag: '总部形象',
        image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop'
      }
    ];

    const btns = document.querySelectorAll('.bento-card');
    const overlay = document.getElementById('scenario-overlay');
    const closeBtn = document.getElementById('scenario-close');
    const content = document.getElementById('scenario-overlay-content');
    
    const expImg = document.getElementById('scenario-expanded-img');
    const expTag = document.getElementById('scenario-expanded-tag');
    const expTitle = document.getElementById('scenario-expanded-title');
    const expCopy = document.getElementById('scenario-expanded-copy');

    // Focus Cards Hover Effect
    btns.forEach(card => {
      card.addEventListener('mouseenter', () => {
        btns.forEach(c => {
          if (c !== card) {
            c.style.filter = 'blur(4px)';
            c.style.opacity = '0.6';
            c.style.transform = 'scale(0.98)';
          }
        });
      });
      card.addEventListener('mouseleave', () => {
        btns.forEach(c => {
          c.style.filter = 'none';
          c.style.opacity = '1';
          c.style.transform = 'scale(1)';
        });
      });
    });

    // Expansion Overlay Logic
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        const data = cardsData[idx];
        
        if(expImg) expImg.setAttribute('src', data.image);
        if(expTag) expTag.textContent = data.tag;
        if(expTitle) expTitle.textContent = data.title;
        if(expCopy) expCopy.textContent = data.copy;

        overlay?.classList.remove('opacity-0', 'pointer-events-none');
        content?.classList.remove('scale-95');
        content?.classList.add('scale-100');
        
        // Prevent body scroll
        document.body.style.overflow = 'hidden';
      });
    });

    closeBtn?.addEventListener('click', () => {
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      content?.classList.remove('scale-100');
      content?.classList.add('scale-95');
      document.body.style.overflow = '';
    });
  }
</script>
