---
import { defaultLocale, normalizeLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const locale = normalizeLocale(Astro.currentLocale ?? defaultLocale);
const t = useTranslations(locale);

const cards = [
  {
    title: t('bentoScenarios.cards.first.title'),
    copy: t('bentoScenarios.cards.first.teaser'),
    expandedCopy: t('bentoScenarios.cards.first.expanded'),
    tag: t('bentoScenarios.cards.first.tag'),
    image: 'https://images.unsplash.com/photo-1494526585095-c41746248156?q=80&w=1974&auto=format&fit=crop',
    shape: 'polygon(20% 0%, 100% 0, 100% 80%, 80% 100%, 0 100%, 0% 20%)'
  },
  {
    title: t('bentoScenarios.cards.second.title'),
    copy: t('bentoScenarios.cards.second.teaser'),
    expandedCopy: t('bentoScenarios.cards.second.expanded'),
    tag: t('bentoScenarios.cards.second.tag'),
    image: 'https://images.unsplash.com/photo-1445019980597-93fa8acb246c?q=80&w=2070&auto=format&fit=crop',
    shape: 'polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%)'
  },
  {
    title: t('bentoScenarios.cards.third.title'),
    copy: t('bentoScenarios.cards.third.teaser'),
    expandedCopy: t('bentoScenarios.cards.third.expanded'),
    tag: t('bentoScenarios.cards.third.tag'),
    image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?q=80&w=2070&auto=format&fit=crop',
    shape: 'polygon(10% 0, 90% 0, 100% 50%, 90% 100%, 10% 100%, 0 50%)'
  },
  {
    title: t('bentoScenarios.cards.fourth.title'),
    copy: t('bentoScenarios.cards.fourth.teaser'),
    expandedCopy: t('bentoScenarios.cards.fourth.expanded'),
    tag: t('bentoScenarios.cards.fourth.tag'),
    image: 'https://images.unsplash.com/photo-1511818966892-d7d671e672a2?q=80&w=2070&auto=format&fit=crop',
    shape: 'polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%)'
  },
  {
    title: t('bentoScenarios.cards.fifth.title'),
    copy: t('bentoScenarios.cards.fifth.teaser'),
    expandedCopy: t('bentoScenarios.cards.fifth.expanded'),
    tag: t('bentoScenarios.cards.fifth.tag'),
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop',
    shape: 'polygon(0 0, 80% 0, 100% 20%, 100% 100%, 20% 100%, 0 80%)'
  },
];
---

<section id="bento-scenarios" class="relative flex min-h-[100svh] w-full flex-col justify-center bg-black py-4 md:py-6 lg:h-[100svh] overflow-hidden">
  <!-- Background Layer for Edge Masks -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <!-- Seamless Edge Masks for vertical blending -->
    <div class="seamless-edge-mask-top"></div>
    <div class="seamless-edge-mask-bottom"></div>
  </div>

  <div class="relative z-10 mx-auto flex min-h-[calc(100svh-2rem)] w-full max-w-[1800px] flex-col px-4 md:min-h-[calc(100svh-3rem)] md:px-8 lg:h-full lg:min-h-0">
    <div class="mb-8 flex flex-col gap-4 px-2 sm:px-4 md:mb-10 md:flex-row md:items-end md:justify-between">
      <div>
        <span class="text-xs font-light tracking-[0.4em] text-[#cfa878]">{t('bentoScenarios.sectionLabel')}</span>
        <h2 class="mt-4 font-serif text-3xl font-normal text-white tracking-[0.15em] sm:text-4xl sm:tracking-widest">{t('bentoScenarios.title')}</h2>
      </div>
      <p class="max-w-[400px] text-sm font-light leading-8 tracking-wider text-neutral-300 md:text-right">
        {t('bentoScenarios.intro')}
      </p>
    </div>

    <div class="grid h-full w-full flex-1 auto-rows-[minmax(15rem,1fr)] grid-cols-1 gap-4 px-2 sm:px-4 md:grid-cols-4 md:grid-rows-2 md:gap-6" id="bento-grid">
      {cards.map((card, index) => (
        <button
          class={`bento-card group relative overflow-hidden rounded-[1.75rem] border border-[#cfa878]/20 bg-black/40 transition-all duration-500 hover:border-[#cfa878]/50 hover:shadow-[0_0_40px_rgba(207,168,120,0.15)] md:rounded-[2.5rem] ${index === 0 ? 'md:col-span-2' : ''} ${index === 1 ? 'md:col-span-1' : ''} ${index === 2 ? 'md:col-span-1' : ''} ${index === 3 ? 'md:col-span-1' : ''} ${index === 4 ? 'md:col-span-3' : ''} will-change-transform transform-gpu`}
          data-index={index}
          data-title={card.title}
          data-tag={card.tag}
          data-image={card.image}
          data-expanded-copy={card.expandedCopy}
          aria-label={card.title}
        >
          <img src={card.image} alt={card.title} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 group-hover:scale-110 will-change-transform transform-gpu" />
          <div class="absolute inset-0 bg-black/60 transition-all duration-500 group-hover:bg-black/30"></div>
          
          <div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-black/90 via-black/40 to-transparent p-6 text-left sm:p-8 md:p-10">
            <span class="inline-block px-4 py-1.5 mb-4 rounded-full border border-[#cfa878]/30 bg-black/40 backdrop-blur-md text-[10px] tracking-[0.2em] text-[#cfa878]">
              {card.tag}
            </span>
            <h3 class="font-serif text-3xl md:text-4xl font-normal text-white mb-3 transform transition-transform duration-500 group-hover:-translate-y-2">{card.title}</h3>
            <p class="text-sm font-light leading-relaxed text-neutral-300 opacity-0 transform translate-y-4 transition-all duration-500 group-hover:opacity-100 group-hover:translate-y-0 line-clamp-2 md:text-base">
              {card.copy}
            </p>
          </div>
        </button>
      ))}
    </div>
  </div>

  <!-- Expanded Overlay -->
  <div id="scenario-overlay" class="fixed inset-0 z-50 flex items-center justify-center bg-black/95 p-4 backdrop-blur-3xl opacity-0 pointer-events-none transition-opacity duration-700">
    <button id="scenario-close" class="absolute top-4 right-4 z-50 flex h-12 w-12 items-center justify-center rounded-full border border-[#cfa878]/30 bg-black/40 text-[#cfa878] transition-colors hover:bg-[#cfa878]/20 md:top-8 md:right-8 md:h-14 md:w-14">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    
    <div class="relative flex max-h-[90vh] w-full max-w-[1400px] scale-95 flex-col overflow-y-auto rounded-[2rem] border border-[#cfa878]/20 shadow-[0_40px_100px_rgba(207,168,120,0.1)] transition-transform duration-700 md:h-[80vh] md:max-h-none md:flex-row md:overflow-hidden md:rounded-[2.5rem]" id="scenario-overlay-content">
      <div class="relative h-[38vh] w-full md:h-full md:w-1/2">
        <img id="scenario-expanded-img" src="" alt="" class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-0 bg-black/20"></div>
      </div>
      <div class="relative flex w-full flex-1 flex-col justify-center overflow-hidden bg-black p-8 sm:p-10 md:h-full md:w-1/2 md:p-24">
        <div class="absolute top-0 right-0 h-64 w-64 rounded-full bg-[#cfa878]/10 blur-[100px] -translate-y-1/2 translate-x-1/3 md:h-96 md:w-96"></div>
        <span id="scenario-expanded-tag" class="text-xs tracking-[0.4em] text-[#cfa878] mb-8"></span>
        <h3 id="scenario-expanded-title" class="mb-8 font-serif text-4xl font-normal text-white md:mb-10 md:text-6xl"></h3>
        <p id="scenario-expanded-copy" class="max-w-lg text-sm font-light leading-relaxed tracking-[0.1em] text-neutral-300 md:text-base md:leading-[2.5]"></p>
      </div>
    </div>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.bento-card'));
    const overlay = document.getElementById('scenario-overlay');
    const closeBtn = document.getElementById('scenario-close');
    const content = document.getElementById('scenario-overlay-content');
    
    const expImg = document.getElementById('scenario-expanded-img');
    const expTag = document.getElementById('scenario-expanded-tag');
    const expTitle = document.getElementById('scenario-expanded-title');
    const expCopy = document.getElementById('scenario-expanded-copy');

    const prefersHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (prefersHover) {
      btns.forEach(card => {
        card.addEventListener('mouseenter', () => {
          btns.forEach(c => {
            if (c !== card) {
              c.style.filter = 'blur(4px)';
              c.style.opacity = '0.6';
              c.style.transform = 'scale(0.98)';
            }
          });
        });
        card.addEventListener('mouseleave', () => {
          btns.forEach(c => {
            c.style.filter = 'none';
            c.style.opacity = '1';
            c.style.transform = 'scale(1)';
          });
        });
      });
    }

    const closeOverlay = () => {
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      content?.classList.remove('scale-100');
      content?.classList.add('scale-95');
      document.body.style.removeProperty('overflow');
    };

    // Expansion Overlay Logic
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const title = btn.getAttribute('data-title') || '';
        const tag = btn.getAttribute('data-tag') || '';
        const image = btn.getAttribute('data-image') || '';
        const expandedCopy = btn.getAttribute('data-expanded-copy') || '';
        
        if(expImg) expImg.setAttribute('src', image);
        if(expTag) expTag.textContent = tag;
        if(expTitle) expTitle.textContent = title;
        if(expCopy) expCopy.textContent = expandedCopy;

        overlay?.classList.remove('opacity-0', 'pointer-events-none');
        content?.classList.remove('scale-95');
        content?.classList.add('scale-100');
        
        // Prevent body scroll
        document.body.style.setProperty('overflow', 'hidden');
      });
    });

    closeBtn?.addEventListener('click', closeOverlay);
    overlay?.addEventListener('click', (event) => {
      if (event.target === overlay) closeOverlay();
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeOverlay();
    });
  }
</script>
