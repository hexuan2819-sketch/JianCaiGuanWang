---
import { defaultLocale, normalizeLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

const locale = normalizeLocale(Astro.currentLocale ?? defaultLocale);
const t = useTranslations(locale);

const features = [
  {
    title: t('coreFeatures.features.first.title'),
    copy: t('coreFeatures.features.first.copy'),
    detail: t('coreFeatures.features.first.detail'),
    image: 'https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?q=80&w=2070&auto=format&fit=crop',
  },
  {
    title: t('coreFeatures.features.second.title'),
    copy: t('coreFeatures.features.second.copy'),
    detail: t('coreFeatures.features.second.detail'),
    image: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=2070&auto=format&fit=crop',
  },
  {
    title: t('coreFeatures.features.third.title'),
    copy: t('coreFeatures.features.third.copy'),
    detail: t('coreFeatures.features.third.detail'),
    image: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=2070&auto=format&fit=crop',
  },
  {
    title: t('coreFeatures.features.fourth.title'),
    copy: t('coreFeatures.features.fourth.copy'),
    detail: t('coreFeatures.features.fourth.detail'),
    image: 'https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?q=80&w=2070&auto=format&fit=crop',
  },
];
---

<section id="core-features" class="relative flex min-h-[100svh] w-full flex-col justify-center overflow-hidden bg-transparent py-4 md:py-6 lg:h-[100svh]">
<div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <img id="feature-bg-blur" src={features[0].image} loading="lazy" decoding="async" class="w-full h-full object-cover opacity-14 blur-[110px] scale-110 transition-all duration-1000 will-change-transform transform-gpu" />
      <div class="overlay-dark-cinematic"></div>
      <div class="overlay-vignette-cinematic opacity-75"></div>
    </div>
  <div class="relative z-10 mx-auto flex min-h-[calc(100svh-2rem)] w-full max-w-[1800px] flex-col px-4 md:min-h-[calc(100svh-3rem)] md:px-10 lg:h-full lg:min-h-0 lg:px-12">
    <div class="mb-8 flex items-center justify-between px-2 md:mb-10">
      <div>
        <span class="text-xs font-light tracking-[0.4em] text-[#cfa878]">{t('coreFeatures.sectionLabel')}</span>
        <h2 class="mt-4 font-serif text-3xl font-normal text-white tracking-[0.15em] sm:text-4xl sm:tracking-widest">{t('coreFeatures.title')}</h2>
      </div>
    </div>

    <div class="flex h-full flex-1 flex-col items-stretch justify-between gap-8 pb-6 md:gap-10 lg:flex-row lg:items-center lg:gap-20 lg:pb-10">
      <!-- Left: Titles List (Aceternity Spotlight Style) -->
      <div class="order-2 flex w-full flex-col justify-center gap-4 md:gap-6 lg:order-1 lg:w-[40%] lg:gap-8" id="feature-list">
        {features.map((feature, index) => (
          <button
            class={`feature-item group relative overflow-hidden rounded-[1.75rem] border p-5 text-left transition-all duration-500 md:rounded-[2rem] md:p-6 lg:p-8 ${index === 0 ? 'border-[#cfa878]/30 bg-black/40 shadow-[0_0_40px_rgba(207,168,120,0.15)] scale-100' : 'border-white/5 bg-transparent hover:border-[#cfa878]/20 hover:bg-black/20 scale-[0.98] md:scale-95 opacity-80 md:opacity-60 hover:opacity-100'}`}
            data-index={index}
            data-image={feature.image}
            data-copy={feature.copy}
            data-detail={feature.detail}
          >
            <!-- Spotlight effect -->
            <div class="absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-[2rem] bg-gradient-to-r from-[#cfa878]/0 via-[#cfa878]/10 to-[#cfa878]/0" style="mask-image: linear-gradient(black, black); mask-composite: exclude;"></div>
            
            <div class="relative z-10 flex items-start gap-4 md:gap-6">
              <span class={`font-serif text-xl font-normal transition-colors duration-500 md:text-2xl ${index === 0 ? 'text-[#cfa878]' : 'text-neutral-500 group-hover:text-[#cfa878]/80'}`}>0{index + 1}</span>
              <div>
                <h3 class={`font-serif text-2xl font-normal tracking-[0.14em] transition-colors duration-500 sm:text-3xl md:text-4xl md:tracking-wider ${index === 0 ? 'text-white' : 'text-neutral-400 group-hover:text-white'}`}>{feature.title}</h3>
                <p class={`mt-3 text-sm font-light leading-8 tracking-wide transition-all duration-500 md:mt-4 ${index === 0 ? 'text-neutral-300 max-h-[200px] opacity-100' : 'text-neutral-500 max-h-0 opacity-0 group-hover:max-h-[200px] group-hover:opacity-100'}`}>
                  {feature.copy}
                </p>
              </div>
            </div>
          </button>
        ))}
      </div>

      <!-- Right: Dynamic Polygon Stage with 3D Depth -->
      <div class="order-1 relative flex h-[38svh] w-full items-center justify-end perspective-[2000px] sm:h-[44svh] lg:order-2 lg:h-[80vh] lg:w-[60%]">
        <div id="feature-3d-stage" class="relative h-full w-full max-w-[1000px] overflow-hidden border border-[#cfa878]/20 bg-black/50 shadow-[0_40px_100px_rgba(207,168,120,0.1)] transition-transform duration-700 ease-out will-change-transform transform-gpu" style="clip-path: polygon(10% 0%, 100% 0, 100% 90%, 90% 100%, 0 100%, 0% 10%); transform-style: preserve-3d;">
          <img id="feature-stage-image" src={features[0].image} alt="Feature Image" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 will-change-opacity" />
          
          <div class="overlay-dark-cinematic"></div>
          <div class="absolute inset-0 bg-gradient-to-tr from-black/70 via-transparent to-transparent"></div>
          <div class="absolute inset-0 blend-noise opacity-50"></div>
          
          <!-- 3D Glare -->
          <div id="feature-glare" class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(255,255,255,0.2),transparent_60%)] opacity-0 transition-opacity duration-300 pointer-events-none mix-blend-overlay"></div>

          <div class="absolute inset-0 flex flex-col justify-end p-6 sm:p-8 md:p-12 lg:p-20" style="transform: translateZ(50px);">
            <div class="mb-6 inline-flex w-max rounded-full border border-[#cfa878]/30 bg-black/40 px-4 py-2.5 backdrop-blur-xl md:mb-8 md:px-6 md:py-3">
              <span class="text-xs tracking-[0.3em] text-[#cfa878]">{t('coreFeatures.stageLabel')}</span>
            </div>
            <p id="feature-stage-detail" class="max-w-2xl text-sm font-light leading-8 tracking-wide text-neutral-200 transition-opacity duration-500 md:text-lg md:leading-relaxed md:tracking-wider">
              {features[0].detail}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    const items = Array.from(document.querySelectorAll<HTMLElement>('.feature-item'));
    const stage = document.getElementById('feature-3d-stage');
    const stageImage = document.getElementById('feature-stage-image');
    const stageDetail = document.getElementById('feature-stage-detail');
    const bgBlur = document.getElementById('feature-bg-blur');
    const glare = document.getElementById('feature-glare');

    // 3D Hover Effect for Stage
    const stageContainer = stage?.parentElement;
    const prefersHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (stageContainer && stage && glare && prefersHover) {
      let ticking = false;
      let isVisible = false;

      const observer = new IntersectionObserver((entries) => {
        isVisible = entries[0].isIntersecting;
      }, { threshold: 0 });
      observer.observe(stageContainer);

      stageContainer.addEventListener('mousemove', (e) => {
        if (!isVisible || ticking) return;

        window.requestAnimationFrame(() => {
          const rect = stageContainer.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          
          const rotateX = ((y - centerY) / centerY) * -5;
          const rotateY = ((x - centerX) / centerX) * 5;
          
          stage.style.transform = `translateZ(0) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
          
          glare.style.opacity = '1';
          glare.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.15), transparent 60%)`;
          
          ticking = false;
        });
        
        ticking = true;
      }, { passive: true });

      stageContainer.addEventListener('mouseleave', () => {
        if (!isVisible) return;
        window.requestAnimationFrame(() => {
          stage.style.transform = 'translateZ(0) rotateX(0) rotateY(0)';
          glare.style.opacity = '0';
        });
      });
    }

    // Spotlight Effect for Items
    const activateItem = (item: HTMLElement) => {
      // Reset all
      items.forEach((el) => {
        el.classList.remove('border-[#cfa878]/30', 'bg-black/40', 'shadow-[0_0_40px_rgba(207,168,120,0.15)]', 'scale-100');
        el.classList.add('border-white/5', 'bg-transparent', 'scale-[0.98]', 'md:scale-95', 'opacity-80', 'md:opacity-60');
        
        const num = el.querySelector('span');
        const title = el.querySelector('h3');
        const p = el.querySelector('p');
        
        num?.classList.remove('text-[#cfa878]');
        num?.classList.add('text-neutral-500');
        
        title?.classList.remove('text-white');
        title?.classList.add('text-neutral-400');
        
        p?.classList.remove('text-neutral-300', 'max-h-[200px]', 'opacity-100');
        p?.classList.add('text-neutral-500', 'max-h-0', 'opacity-0');
      });
      
      // Activate current
      item.classList.remove('border-white/5', 'bg-transparent', 'scale-[0.98]', 'md:scale-95', 'opacity-80', 'md:opacity-60');
      item.classList.add('border-[#cfa878]/30', 'bg-black/40', 'shadow-[0_0_40px_rgba(207,168,120,0.15)]', 'scale-100');

      const num = item.querySelector('span');
      const title = item.querySelector('h3');
      const p = item.querySelector('p');
      
      num?.classList.remove('text-neutral-500');
      num?.classList.add('text-[#cfa878]');
      
      title?.classList.remove('text-neutral-400');
      title?.classList.add('text-white');
      
      p?.classList.remove('text-neutral-500', 'max-h-0', 'opacity-0');
      p?.classList.add('text-neutral-300', 'max-h-[200px]', 'opacity-100');

      // Update content with fade effect
      if (stageDetail && stageImage && bgBlur) {
        stageDetail.style.opacity = '0';
        stageImage.style.opacity = '0.5';
        
        setTimeout(() => {
          const imgSrc = item.getAttribute('data-image') || '';
          stageImage.setAttribute('src', imgSrc);
          bgBlur.setAttribute('src', imgSrc);
          stageDetail.textContent = item.getAttribute('data-detail') || '';
          
          stageDetail.style.opacity = '1';
          stageImage.style.opacity = '1';
        }, 300);
      }
    };

    items.forEach((item) => {
      let itemTicking = false;
      
      item.addEventListener('mousemove', (e: MouseEvent) => {
        if (itemTicking) return;
        window.requestAnimationFrame(() => {
          const rect = item.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          item.style.setProperty('--mouse-x', `${x}px`);
          item.style.setProperty('--mouse-y', `${y}px`);
          itemTicking = false;
        });
        itemTicking = true;
      }, { passive: true });

      if (prefersHover) {
        item.addEventListener('mouseenter', () => activateItem(item));
      }

      item.addEventListener('click', () => activateItem(item));
      item.addEventListener('focus', () => activateItem(item));
    });
  }
</script>

<style>
  .feature-item::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 2rem;
    padding: 1px;
    background: radial-gradient(
      800px circle at var(--mouse-x, 0) var(--mouse-y, 0),
      rgba(255, 255, 255, 0.15),
      transparent 40%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s;
  }
  .feature-item:hover::before {
    opacity: 1;
  }
</style>
