---
const products = [
  {
    title: 'Calacatta Reserve',
    meta: 'Interior Marble',
    image: 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=2070&auto=format&fit=crop',
  },
  {
    title: 'Porcelain Monolith',
    meta: 'Exterior Surface',
    image: 'https://images.unsplash.com/photo-1511818966892-d7d671e672a2?q=80&w=2069&auto=format&fit=crop',
  },
  {
    title: 'Thermo Ash',
    meta: 'Wood Veneer',
    image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?q=80&w=2070&auto=format&fit=crop',
  },
  {
    title: 'Anodized Bronze',
    meta: 'Metal System',
    image: 'https://images.unsplash.com/photo-1604014237800-1c9102c219da?q=80&w=1974&auto=format&fit=crop',
  },
];
---

<!-- 这里的 section 给一个长高度 400dvh，让用户在此处滚动，内部使用 sticky 容器固定画面 -->
<section id="stacking-products" class="h-[400dvh] w-full snap-start snap-always bg-stone-100">
  <div class="sticky top-0 flex h-[100dvh] w-full items-center justify-center overflow-hidden">
    <div class="absolute left-6 top-1/2 -translate-y-1/2 md:left-12 lg:left-24 z-20">
      <div class="mask-reveal-container mb-4">
        <p class="mask-reveal-element stack-reveal text-sm uppercase tracking-[0.4em] text-stone-500">
          Signature Series
        </p>
      </div>
      <div class="mask-reveal-container">
        <h2 class="mask-reveal-element stack-reveal font-display text-4xl font-light tracking-[-0.05em] leading-[1.1] text-stone-900 md:text-6xl">
          Materials in<br />Motion
        </h2>
      </div>
    </div>

    <div class="relative h-[60vh] w-[80vw] max-w-lg md:h-[70vh] perspective-[1200px]">
      {products.map((product, index) => (
        <article
          class="stack-card absolute inset-0 rounded-[2rem] bg-stone-200 shadow-architectural will-change-transform transform-origin-bottom overflow-hidden border border-white/40"
          style={`z-index: ${products.length - index}`}
        >
          <img
            src={product.image}
            alt={product.title}
            class="absolute inset-0 h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/80 via-transparent to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-8 text-center">
            <p class="text-xs uppercase tracking-[0.3em] text-amber-500">{product.meta}</p>
            <h3 class="mt-2 font-display text-3xl font-light text-white">{product.title}</h3>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    window.addEventListener('cinematic:ready', async () => {
      try {
        const gsap = (await import('gsap')).default;
        const ScrollTrigger = (await import('gsap/ScrollTrigger')).default;
        gsap.registerPlugin(ScrollTrigger);

        const section = document.getElementById('stacking-products');
        if (!section) return;

        // 1. 入场文字揭示
        ScrollTrigger.create({
          trigger: section,
          scroller: '#main-scroller',
          start: 'top 60%',
          onEnter: () => {
            gsap.to('.stack-reveal', {
              y: 0,
              duration: 1.4,
              ease: 'power4.out',
              stagger: 0.1,
            });
          },
        });

        // 2. 堆叠卡片滚动动画
        const cards = gsap.utils.toArray('.stack-card');
        
        // 初始设置，后面的卡片缩放变小、下移
        gsap.set(cards, {
          y: (i) => i * 40,
          scale: (i) => 1 - i * 0.05,
          opacity: (i) => 1 - i * 0.15,
        });

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: section,
            scroller: '#main-scroller',
            start: 'top top',
            end: 'bottom bottom',
            scrub: true,
          }
        });

        // 除去最后一张，前面的每一张都在滚动时向上滑出并旋转消失
        cards.forEach((card, index) => {
          if (index === cards.length - 1) return;

          tl.to(card, {
            yPercent: -120,
            rotationX: 30,
            opacity: 0,
            duration: 1,
            ease: 'power2.inOut',
          }, index * 1);

          // 当前卡片滑走时，后面的所有卡片上移放大
          for (let j = index + 1; j < cards.length; j++) {
            tl.to(cards[j], {
              y: (j - index - 1) * 40,
              scale: 1 - (j - index - 1) * 0.05,
              opacity: 1 - (j - index - 1) * 0.15,
              duration: 1,
              ease: 'power2.inOut',
            }, index * 1);
          }
        });

      } catch (error) {
        console.error('Stacking Products animation failed:', error);
      }
    });
  }
</script>
