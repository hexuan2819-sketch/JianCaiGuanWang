---
import { defaultLocale, normalizeLocale } from '../../i18n/config';
import { getLocalizedPathname } from '../../i18n/ui';

const locale = normalizeLocale(Astro.currentLocale ?? defaultLocale);
const isZh = locale === 'zh';
---
<div id="product-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 backdrop-blur-sm md:p-8" role="dialog" aria-modal="true">
  <div class="absolute inset-0 bg-black/60" data-modal-close></div>
  <div class="relative z-10 flex max-h-[92vh] w-full max-w-[1100px] flex-col overflow-hidden bg-white shadow-[0_40px_120px_rgba(0,0,0,0.25)]">
    <div class="flex items-center justify-between border-b border-black/6 px-6 py-5 md:px-10 md:py-6">
      <div>
        <p id="modal-product-id" class="text-[10px] font-semibold uppercase tracking-[0.22em] text-neutral-400"></p>
        <h2 id="modal-product-title" class="mt-1 text-2xl font-semibold tracking-[-0.03em] text-ink md:text-3xl"></h2>
      </div>
      <button
        type="button"
        data-modal-close
        class="flex h-10 w-10 items-center justify-center rounded-full border border-black/10 bg-white transition-colors hover:bg-neutral-100"
        aria-label={isZh ? '关闭' : 'Close'}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="overflow-y-auto px-6 py-6 md:px-10 md:py-8" id="modal-scroll">
      <p id="modal-product-subtitle" class="text-sm font-medium tracking-[0.04em] text-neutral-500"></p>
      <p id="modal-product-desc" class="mt-4 max-w-[48rem] text-sm leading-[1.8] text-neutral-600"></p>
      <div id="modal-product-facts" class="mt-8 grid gap-3 sm:grid-cols-2 md:grid-cols-3"></div>
      <div class="mt-10 border-t border-black/6 pt-8">
        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-neutral-400">{isZh ? '技术资料与认证' : 'Documents & Certifications'}</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <div class="flex items-center justify-between border border-black/6 px-5 py-4">
            <span class="text-sm text-neutral-700">{isZh ? '技术规格书' : 'Technical Data Sheet'}</span>
            <span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-400">PDF</span>
          </div>
          <div class="flex items-center justify-between border border-black/6 px-5 py-4">
            <span class="text-sm text-neutral-700">{isZh ? '第三方检测报告' : 'Third-party Test Report'}</span>
            <span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-400">PDF</span>
          </div>
          <div class="flex items-center justify-between border border-black/6 px-5 py-4">
            <span class="text-sm text-neutral-700">{isZh ? 'CAD 节点详图' : 'CAD Detail Drawings'}</span>
            <span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-400">DWG</span>
          </div>
          <div class="flex items-center justify-between border border-black/6 px-5 py-4">
            <span class="text-sm text-neutral-700">{isZh ? 'BIM 模型文件' : 'BIM Model Files'}</span>
            <span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-400">RVT</span>
          </div>
        </div>
      </div>
      <div class="mt-8 flex flex-col gap-4 border-t border-black/6 pt-8 sm:flex-row">
        <a
          id="modal-detail-link"
          href="#"
          class="inline-flex items-center justify-center bg-steel px-8 py-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-white transition-colors hover:bg-graphite"
        >
          {isZh ? '查看完整规格书' : 'View Full Spec Sheet'}
          <svg class="ml-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
        <button
          type="button"
          data-modal-close
          class="inline-flex items-center justify-center border border-black/10 bg-white px-8 py-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-ink transition-colors hover:bg-neutral-50"
        >
          {isZh ? '返回产品列表' : 'Back to Products'}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  if (typeof window !== 'undefined') {
    const modal = document.getElementById('product-modal');
    const scrollEl = document.getElementById('modal-scroll');
    const triggers = document.querySelectorAll('[data-product-trigger]');
    const closes = document.querySelectorAll('[data-modal-close]');

    const openModal = function(trigger) {
      if (!modal || !scrollEl) return;
      const id = trigger.dataset.productId ?? '';
      const title = trigger.dataset.productTitle ?? '';
      const subtitle = trigger.dataset.productSubtitle ?? '';
      const desc = trigger.dataset.productDesc ?? '';
      const href = trigger.dataset.productHref ?? '#';
      const factsRaw = trigger.dataset.productFacts;
      let facts = [];
      try { facts = JSON.parse(factsRaw ?? '[]'); } catch (e) { /* ignore */ }

      const modalId = document.getElementById('modal-product-id');
      const modalTitle = document.getElementById('modal-product-title');
      const modalSubtitle = document.getElementById('modal-product-subtitle');
      const modalDesc = document.getElementById('modal-product-desc');
      const modalFacts = document.getElementById('modal-product-facts');
      const modalLink = document.getElementById('modal-detail-link');

      if (modalId) modalId.textContent = id;
      if (modalTitle) modalTitle.textContent = title;
      if (modalSubtitle) modalSubtitle.textContent = subtitle;
      if (modalDesc) modalDesc.textContent = desc;
      if (modalLink) modalLink.href = href;

      if (modalFacts) {
        modalFacts.innerHTML = '';
        facts.forEach(function(item) {
          const div = document.createElement('div');
          div.className = 'border border-black/6 bg-white/70 px-4 py-4';
          div.innerHTML = '<p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-500">' + item[0] + '</p><p class="mt-2 text-sm font-semibold text-ink">' + item[1] + '</p>';
          modalFacts.appendChild(div);
        });
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      if (scrollEl) scrollEl.scrollTop = 0;
    };

    const closeModal = function() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    };

    triggers.forEach(function(trigger) {
      trigger.addEventListener('click', function() { openModal(trigger); });
    });

    closes.forEach(function(el) {
      el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }
</script>
