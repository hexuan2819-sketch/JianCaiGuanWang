---
const backgroundImage =
  'https://images.unsplash.com/photo-1511818966892-d7d671e672a2?q=80&w=2069&auto=format&fit=crop';
---

<section id="hero-slide" class="group relative h-[100dvh] snap-start snap-always overflow-hidden">
  <img src={backgroundImage} alt="Architectural landmark facade" class="absolute inset-0 h-full w-full object-cover" />
  <div class="absolute inset-0 bg-black/25 transition-colors duration-500 group-hover:bg-black/15"></div>
  <div class="absolute inset-0 bg-transparent transition-all duration-500 group-hover:backdrop-blur-md group-hover:bg-black/20"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent"></div>

  <div class="relative z-10 flex h-full items-end px-6 pb-16 pt-32 md:px-12 md:pb-20">
    <div class="max-w-5xl">
      <p class="hero-reveal overflow-hidden text-xs uppercase tracking-[0.34em] text-white/70">
        <span class="hero-reveal-line inline-block">Full-page Immersive Slides</span>
      </p>
      <div class="mt-5 overflow-hidden">
        <h1 class="hero-reveal font-display text-5xl font-light leading-[0.92] tracking-[-0.06em] text-white sm:text-6xl md:text-8xl lg:text-[8.8rem]">
          <span class="hero-reveal-line inline-block">Architectural</span>
          <br />
          <span class="hero-reveal-line inline-block">Matter in Motion</span>
        </h1>
      </div>
      <div class="mt-6 max-w-2xl overflow-hidden">
        <p class="hero-reveal text-base leading-8 text-white/80 md:text-xl">
          <span class="hero-reveal-line inline-block">
            A cinematic landing scene that merges high-end building materials, museum-grade typography, and large-scale motion design into one calm, powerful first impression.
          </span>
        </p>
      </div>
      <div class="mt-10 flex flex-wrap gap-4 overflow-hidden">
        <a href="#category-slide" class="hero-reveal-line inline-flex rounded-full bg-white px-7 py-3.5 text-sm font-medium uppercase tracking-[0.16em] text-stone-900 transition hover:-translate-y-0.5">
          Explore Categories
        </a>
        <a href="#carousel-slide" class="hero-reveal-line inline-flex rounded-full border border-white/30 bg-white/10 px-7 py-3.5 text-sm font-medium uppercase tracking-[0.16em] text-white backdrop-blur transition hover:bg-white/20">
          View Gallery
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    window.addEventListener('load', async () => {
      try {
        const gsap = (await import('gsap')).default;

        gsap.set('#hero-slide .hero-reveal-line', {
          yPercent: 110,
          opacity: 0,
        });

        gsap.to('#hero-slide .hero-reveal-line', {
          yPercent: 0,
          opacity: 1,
          duration: 1.1,
          ease: 'power4.out',
          stagger: 0.1,
          delay: 0.25,
        });
      } catch (error) {
        console.error('Hero section animation failed:', error);
      }
    });
  }
</script>
