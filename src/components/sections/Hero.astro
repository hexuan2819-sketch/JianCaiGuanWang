---
const backgroundImage =
  'https://images.unsplash.com/photo-1511818966892-d7d671e672a2?q=80&w=2069&auto=format&fit=crop';
const sideImages = [
  'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=900&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1518005020951-eccb494ad742?q=80&w=900&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?q=80&w=900&auto=format&fit=crop',
];
---

<section id="hero" class="h-[100svh] w-full flex flex-col justify-center bg-transparent pt-24 pb-6 perspective-[2000px]">
  <div class="mx-auto w-full max-w-[1800px] px-4 md:px-8 h-full flex flex-col relative z-10" id="hero-3d-container">
    <!-- Hero 3D Card -->
    <div id="hero-stage" class="relative flex-1 overflow-hidden rounded-[2.5rem] border border-white/10 shadow-2xl transition-all duration-300 ease-out will-change-transform transform-gpu" style="transform-style: preserve-3d;">
      <img
        src={backgroundImage}
        alt="深色建筑立面"
        loading="eager"
        decoding="async"
        class="absolute inset-0 h-[110%] w-[110%] object-cover -top-[5%] -left-[5%] transition-transform duration-500 will-change-transform transform-gpu"
        id="hero-image"
      />
      <!-- Dynamic Glare -->
      <div id="hero-glare" class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(255,255,255,0.15),transparent_60%)] opacity-0 transition-opacity duration-300 pointer-events-none mix-blend-overlay"></div>
      
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(18,18,20,0.1),rgba(18,18,20,0.85))]"></div>
      
      <!-- Glowing Orbs with 3D Depth -->
      <div id="hero-orb-a" class="absolute left-[8%] top-[12%] h-[30vh] w-[30vh] rounded-full bg-white/10 blur-[100px] mix-blend-screen pointer-events-none" style="transform: translateZ(40px);"></div>
      <div id="hero-orb-b" class="absolute bottom-[10%] right-[8%] h-[40vh] w-[40vh] rounded-full bg-stone-300/10 blur-[120px] mix-blend-screen pointer-events-none" style="transform: translateZ(80px);"></div>
      
      <div class="absolute inset-0 blend-noise opacity-40"></div>

      <div class="relative grid h-full items-end gap-10 px-8 py-16 md:px-16 lg:grid-cols-[1fr_1fr] lg:items-center">
        <!-- Text Content floating in 3D space -->
        <div id="hero-copy" class="max-w-[760px] pointer-events-none" data-animate-group style="transform: translateZ(100px);">
          <span data-animate-item class="mb-5 inline-flex rounded-full border border-white/10 bg-black/20 px-4 py-2 text-[10px] font-light tracking-[0.34em] text-neutral-300">
            GLOBAL MATERIALS SUPPLY NETWORK
          </span>
          <h1 data-animate-item class="font-display text-[clamp(2.8rem,6vw,6.2rem)] font-light leading-[0.96] tracking-[-0.04em] text-white">
            筑物为诗，匠心无界
          </h1>
          <p data-animate-item class="mt-6 max-w-[42rem] text-sm font-light leading-8 tracking-[0.08em] text-neutral-200 md:text-base">
            以全球建材供应链为底座，连接原产地、工厂与项目现场。
            从中东到中亚，我们以稳定交付、精密工艺与审美判断，服务真正具有标志性的空间作品。
          </p>
          <div data-animate-item class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="#global-vision"
              class="inline-flex items-center gap-3 rounded-full border border-white/20 bg-white/10 px-8 py-4 text-xs font-light tracking-[0.24em] text-white transition-all duration-500 hover:bg-white/20 hover:scale-105 backdrop-blur-md pointer-events-auto"
            >
              探索更多
              <span class="text-sm">+</span>
            </a>
            <div class="flex items-center gap-6 pointer-events-auto">
              <div class="bg-black/20 backdrop-blur-md border border-white/5 rounded-2xl p-4 transition-transform duration-300 hover:-translate-y-1">
                <p class="text-3xl font-light text-white">17</p>
                <p class="mt-1 text-[10px] tracking-[0.24em] text-neutral-400">国家地区覆盖</p>
              </div>
              <div class="bg-black/20 backdrop-blur-md border border-white/5 rounded-2xl p-4 transition-transform duration-300 hover:-translate-y-1">
                <p class="text-3xl font-light text-white">200+</p>
                <p class="mt-1 text-[10px] tracking-[0.24em] text-neutral-400">项目交付经验</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 3D Floating Images -->
        <div class="relative hidden h-full lg:flex items-center justify-center pointer-events-none" id="hero-floating-images" style="transform: translateZ(120px);">
          <div class="absolute -left-12 top-1/4 h-[300px] w-[240px] overflow-hidden rounded-[2rem] border border-white/10 shadow-[0_30px_100px_rgba(0,0,0,0.5)] transition-transform duration-700 hover:scale-105 pointer-events-auto" style="transform: translateZ(60px) rotateY(15deg);">
            <img src={sideImages[0]} alt="建筑细节" class="h-full w-full object-cover opacity-80 hover:opacity-100 transition-opacity duration-500" data-animate-item />
          </div>
          <div class="absolute right-0 top-1/3 h-[380px] w-[300px] overflow-hidden rounded-[2rem] border border-white/20 shadow-[0_40px_120px_rgba(0,0,0,0.6)] z-10 transition-transform duration-700 hover:scale-105 pointer-events-auto" style="transform: translateZ(100px);">
            <img src={sideImages[1]} alt="项目现场" class="h-full w-full object-cover" data-animate-item />
          </div>
          <div class="absolute left-1/4 bottom-1/4 h-[260px] w-[200px] overflow-hidden rounded-[2rem] border border-white/10 shadow-[0_20px_80px_rgba(0,0,0,0.4)] transition-transform duration-700 hover:scale-105 pointer-events-auto" style="transform: translateZ(40px) rotateY(-15deg);">
            <img src={sideImages[2]} alt="材料空间" class="h-full w-full object-cover opacity-70 hover:opacity-100 transition-opacity duration-500" data-animate-item />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    const container = document.getElementById('hero-3d-container');
    const stage = document.getElementById('hero-stage');
    const glare = document.getElementById('hero-glare');
    const image = document.getElementById('hero-image');

    if (container && stage && glare && image) {
      let ticking = false;
      let isVisible = true;

      // Only animate when section is in viewport
      const observer = new IntersectionObserver((entries) => {
        isVisible = entries[0].isIntersecting;
      }, { threshold: 0 });
      observer.observe(container);

      container.addEventListener('mousemove', (e) => {
        if (!isVisible || ticking) return;

        window.requestAnimationFrame(() => {
          const rect = container.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          
          // Aceternity style 3D rotation
          const rotateX = ((y - centerY) / centerY) * -4; // Subtle 4deg max rotation
          const rotateY = ((x - centerX) / centerX) * 4;
          
          stage.style.transform = `translateZ(0) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
          
          // Parallax background (opposite direction)
          image.style.transform = `translate3d(${rotateY * -2}px, ${rotateX * 2}px, 0) scale(1.05)`;
          
          // Glare effect following mouse
          glare.style.opacity = '1';
          glare.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.15), transparent 60%)`;
          
          ticking = false;
        });
        
        ticking = true;
      }, { passive: true });

      container.addEventListener('mouseleave', () => {
        if (!isVisible) return;
        window.requestAnimationFrame(() => {
          stage.style.transform = 'translateZ(0) rotateX(0) rotateY(0)';
          image.style.transform = 'translate3d(0, 0, 0) scale(1)';
          glare.style.opacity = '0';
        });
      });
    }
  }
</script>
