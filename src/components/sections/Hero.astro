---
import { defaultLocale, normalizeLocale } from '../../i18n/config';
import { getLocalizedPathname } from '../../i18n/ui';

const locale = normalizeLocale(Astro.currentLocale ?? defaultLocale);
const isZh = locale === 'zh';
const backgroundImage =
  'https://images.unsplash.com/photo-1513828583688-c52646db42da?q=80&w=2200&auto=format&fit=crop';

const copy = isZh
  ? {
      title: '工程保温与声学材料',
      subtitle: 'ISO / EN / ASTM 标准体系  ·  全球项目交付',
      cta: '查看产品',
      imageAlt: '工业设施与工程保温结构',
      badge: 'ASTM · EN · ISO',
    }
  : {
      title: 'Engineered Thermal Insulation',
      subtitle: 'ISO / EN / ASTM Compliance  ·  Global Project Delivery',
      cta: 'View Products',
      imageAlt: 'Industrial facility and engineered insulation systems',
      badge: 'ASTM · EN · ISO',
    };
---

<section id="hero" class="relative flex min-h-[100svh] items-end overflow-hidden">
  <div class="absolute inset-0">
    <img
      id="hero-image"
      src={backgroundImage}
      alt={copy.imageAlt}
      loading="eager"
      decoding="async"
      class="parallax-media absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/25 to-black/10"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/30 via-transparent to-transparent"></div>
  </div>

  <div class="relative w-full px-6 pb-16 pt-40 md:px-12 md:pb-24 md:pt-48 lg:px-20 lg:pb-28 xl:px-28">
    <div class="mx-auto max-w-[1440px]">
      <div data-animate class="max-w-[800px]">
        <h1 class="text-balance font-display text-[clamp(2.8rem,6vw,5.5rem)] font-semibold leading-[0.94] tracking-[-0.04em] text-white">
          {copy.title}
        </h1>
        <p class="mt-6 max-w-[520px] text-[clamp(0.95rem,1.05vw,1.1rem)] leading-[1.7] text-white/75 md:mt-8">
          {copy.subtitle}
        </p>
        <div class="mt-10 md:mt-12">
          <a
            href={getLocalizedPathname(locale, '/products/')}
            class="inline-flex items-center gap-3 border border-white/25 bg-white/10 px-8 py-4 text-sm font-medium tracking-[0.06em] text-white backdrop-blur-sm transition-all duration-500 hover:bg-white/20 hover:shadow-[0_0_40px_rgba(255,255,255,0.08)]"
          >
            {copy.cta}
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <div class="mt-16 flex items-center gap-8 border-t border-white/10 pt-8 md:mt-20 md:pt-10">
        <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-white/45">{copy.badge}</span>
        <span class="h-px w-12 bg-white/15"></span>
        <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-white/45">{isZh ? '全球项目交付' : 'Global Delivery'}</span>
      </div>
    </div>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    const section = document.getElementById('hero');
    const image = document.getElementById('hero-image');
    if (section && image) {
      const applyParallax = () => {
        const rect = section.getBoundingClientRect();
        const progress = Math.min(Math.max((window.innerHeight - rect.top) / (window.innerHeight + rect.height), 0), 1);
        const offset = (progress - 0.5) * 18;
        image.style.transform = `translate3d(0, ${offset}px, 0) scale(1.05)`;
      };
      applyParallax();
      window.addEventListener('scroll', applyParallax, { passive: true });
      window.addEventListener('resize', applyParallax);
    }
  }
</script>
