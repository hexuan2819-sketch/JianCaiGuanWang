---
---

<header id="global-header" class="fixed left-0 top-0 z-50 w-full bg-transparent px-4 py-4 text-neutral-100 transition-all duration-500 md:px-10 md:py-5">
  <div class="mx-auto flex max-w-[1600px] items-center justify-between gap-4">
    <a href="#hero" class="shrink-0 font-display text-[11px] font-light tracking-[0.28em] text-neutral-100 sm:text-sm sm:tracking-[0.36em] md:text-base">
      筑 物 为 诗
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      <a href="#hero" class="editorial-label transition-colors duration-500 hover:text-white">首章</a>
      <a href="#global-vision" class="editorial-label transition-colors duration-500 hover:text-white">版图</a>
      <a href="#category-stone" class="editorial-label transition-colors duration-500 hover:text-white">原石</a>
      <a href="#category-wood" class="editorial-label transition-colors duration-500 hover:text-white">木艺</a>
      <a href="#bento-scenarios" class="editorial-label transition-colors duration-500 hover:text-white">场景</a>
      <a href="#core-features" class="editorial-label transition-colors duration-500 hover:text-white">优势</a>
      <a href="#craftsmanship" class="editorial-label transition-colors duration-500 hover:text-white">工艺</a>
      <a href="#contact-form" class="editorial-label transition-colors duration-500 hover:text-white">洽询</a>
    </nav>

    <a href="#contact-form" class="hidden border-b border-white/30 pb-1 text-[11px] font-light tracking-[0.28em] text-neutral-300 transition-colors duration-500 hover:border-white hover:text-white md:inline-block">
      项目洽询
    </a>

    <button
      id="mobile-nav-toggle"
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-black/25 text-white backdrop-blur-xl transition-all duration-300 hover:bg-white/10 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      aria-label="打开导航"
    >
      <span class="sr-only">打开导航</span>
      <svg class="pointer-events-none h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-nav-panel"
    class="pointer-events-none absolute inset-x-4 top-[calc(100%+0.5rem)] rounded-[1.75rem] border border-white/10 bg-neutral-950/90 p-5 opacity-0 shadow-[0_30px_80px_rgba(0,0,0,0.45)] backdrop-blur-2xl transition-all duration-300 lg:hidden"
    aria-hidden="true"
  >
    <nav class="grid gap-2">
      <a href="#hero" class="rounded-2xl px-4 py-3 text-sm font-light tracking-[0.18em] text-neutral-200 transition-colors duration-300 hover:bg-white/5 hover:text-white">首章</a>
      <a href="#global-vision" class="rounded-2xl px-4 py-3 text-sm font-light tracking-[0.18em] text-neutral-200 transition-colors duration-300 hover:bg-white/5 hover:text-white">版图</a>
      <a href="#category-stone" class="rounded-2xl px-4 py-3 text-sm font-light tracking-[0.18em] text-neutral-200 transition-colors duration-300 hover:bg-white/5 hover:text-white">原石</a>
      <a href="#category-wood" class="rounded-2xl px-4 py-3 text-sm font-light tracking-[0.18em] text-neutral-200 transition-colors duration-300 hover:bg-white/5 hover:text-white">木艺</a>
      <a href="#bento-scenarios" class="rounded-2xl px-4 py-3 text-sm font-light tracking-[0.18em] text-neutral-200 transition-colors duration-300 hover:bg-white/5 hover:text-white">场景</a>
      <a href="#core-features" class="rounded-2xl px-4 py-3 text-sm font-light tracking-[0.18em] text-neutral-200 transition-colors duration-300 hover:bg-white/5 hover:text-white">优势</a>
      <a href="#craftsmanship" class="rounded-2xl px-4 py-3 text-sm font-light tracking-[0.18em] text-neutral-200 transition-colors duration-300 hover:bg-white/5 hover:text-white">工艺</a>
      <a href="#contact-form" class="rounded-2xl bg-white/8 px-4 py-3 text-sm font-light tracking-[0.18em] text-white transition-colors duration-300 hover:bg-white/12">项目洽询</a>
    </nav>
  </div>
</header>

<script>
  if (typeof window !== 'undefined') {
    const header = document.getElementById('global-header');
    const toggle = document.getElementById('mobile-nav-toggle');
    const panel = document.getElementById('mobile-nav-panel');
    const mobileLinks = panel?.querySelectorAll('a[href^="#"]') ?? [];
    const desktopMedia = window.matchMedia('(min-width: 1024px)');

    const closeMenu = () => {
      if (!toggle || !panel) return;
      toggle.setAttribute('aria-expanded', 'false');
      panel.setAttribute('aria-hidden', 'true');
      panel.classList.add('pointer-events-none', 'opacity-0', '-translate-y-2');
      document.body.style.removeProperty('overflow');
    };

    const openMenu = () => {
      if (!toggle || !panel) return;
      toggle.setAttribute('aria-expanded', 'true');
      panel.setAttribute('aria-hidden', 'false');
      panel.classList.remove('pointer-events-none', 'opacity-0', '-translate-y-2');
      document.body.style.setProperty('overflow', 'hidden');
    };

    const updateHeaderState = () => {
      if (!header) return;

      if (window.scrollY > 24) {
        header.classList.add('backdrop-blur-xl', 'bg-neutral-950/70');
        header.classList.remove('bg-transparent');
      } else {
        header.classList.remove('backdrop-blur-xl', 'bg-neutral-950/70');
        header.classList.add('bg-transparent');
      }
    };

    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      if (expanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => closeMenu());
    });

    desktopMedia.addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });

    window.addEventListener('resize', () => {
      if (desktopMedia.matches) closeMenu();
    });
    window.addEventListener('scroll', updateHeaderState, { passive: true });
    window.addEventListener('load', updateHeaderState, { once: true });
    closeMenu();
  }
</script>
