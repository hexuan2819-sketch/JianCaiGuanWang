---
import { defaultLocale, getLocaleLabel, locales, normalizeLocale } from '../../i18n/config';
import { getLocalizedPathname, useTranslations } from '../../i18n/ui';

const currentLocale = normalizeLocale(Astro.currentLocale ?? defaultLocale);
const t = useTranslations(currentLocale);
const currentPathname = Astro.url.pathname;

const languageItems = locales.map((locale) => ({
  code: locale,
  name: getLocaleLabel(locale),
  href: getLocalizedPathname(locale, currentPathname),
  active: locale === currentLocale,
}));
---

<div class="relative" data-language-picker>
  <button
    type="button"
    class="inline-flex h-11 items-center gap-3 border border-black/10 bg-white px-4 text-[11px] font-semibold tracking-[0.16em] text-ink transition-all duration-300 hover:bg-stone-50"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-label={t('actions.chooseLanguage')}
    data-language-picker-toggle
  >
    <span data-language-picker-code class="text-stone-700">{currentLocale.toUpperCase()}</span>
    <span data-language-picker-label class="hidden text-stone-600 sm:inline">{getLocaleLabel(currentLocale)}</span>
    <svg class="h-4 w-4 text-stone-500 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-language-picker-icon>
      <path d="M6 9l6 6 6-6" />
    </svg>
  </button>

  <div
    class="pointer-events-none absolute end-0 top-[calc(100%+0.5rem)] z-50 w-[min(92vw,34rem)] border border-black/10 bg-white p-4 opacity-0 shadow-editorial transition-all duration-300 translate-y-2"
    aria-hidden="true"
    data-language-picker-panel
  >
    <div class="mb-4 flex items-start justify-between gap-4 px-2">
      <div>
        <p class="text-[10px] tracking-[0.3em] text-stone-500">{t('languagePicker.current')}</p>
        <h3 class="mt-2 text-lg font-light text-ink">{t('languagePicker.title')}</h3>
        <p class="mt-2 max-w-md text-sm font-light leading-6 text-stone-600">{t('languagePicker.description')}</p>
      </div>
      <span class="border border-black/8 bg-concrete px-3 py-1 text-[10px] font-semibold tracking-[0.24em] text-stone-600">
        {currentLocale.toUpperCase()}
      </span>
    </div>

    <div class="max-h-[55svh] overflow-y-auto pe-1">
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
        {languageItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'group border px-4 py-3 transition-all duration-300',
              item.active
                ? 'border-black/12 bg-concrete text-ink'
                : 'border-black/6 bg-white text-stone-700 hover:border-black/12 hover:bg-concrete hover:text-ink',
            ]}
            data-language-option
            data-locale={item.code}
          >
            <span class="block text-sm font-light">{item.name}</span>
            <span class="mt-1 block text-[10px] tracking-[0.24em] text-stone-500 group-hover:text-stone-700">
              {item.code.toUpperCase()}
            </span>
          </a>
        ))}
      </div>
    </div>

    <p class="mt-4 px-2 text-[11px] font-light leading-5 text-stone-500">{t('languagePicker.cookieNotice')}</p>
  </div>
</div>

<script>
  if (typeof window !== 'undefined') {
    document.querySelectorAll('[data-language-picker]').forEach((picker) => {
      const toggle = picker.querySelector('[data-language-picker-toggle]');
      const panel = picker.querySelector('[data-language-picker-panel]');
      const icon = picker.querySelector('[data-language-picker-icon]');
      const options = picker.querySelectorAll('[data-language-option]');

      if (!toggle || !panel) return;

      const closePanel = () => {
        toggle.setAttribute('aria-expanded', 'false');
        panel.setAttribute('aria-hidden', 'true');
        panel.classList.add('pointer-events-none', 'opacity-0', 'translate-y-2');
        icon?.classList.remove('rotate-180');
      };

      const openPanel = () => {
        toggle.setAttribute('aria-expanded', 'true');
        panel.setAttribute('aria-hidden', 'false');
        panel.classList.remove('pointer-events-none', 'opacity-0', 'translate-y-2');
        icon?.classList.add('rotate-180');
      };

      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        if (expanded) {
          closePanel();
        } else {
          openPanel();
        }
      });

      options.forEach((option) => {
        option.addEventListener('click', (event) => {
          event.preventDefault();
          const href = option.getAttribute('href');
          const locale = option.getAttribute('data-locale');
          if (!href || !locale) return;

          document.cookie = `preferred_locale=${locale}; path=/; max-age=31536000; SameSite=Lax`;
          document.body.animate([{ opacity: 1 }, { opacity: 0.88 }], {
            duration: 160,
            easing: 'ease-out',
            fill: 'forwards',
          });

          window.setTimeout(() => {
            window.location.assign(href);
          }, 140);
        });
      });

      document.addEventListener('click', (event) => {
        if (!picker.contains(event.target)) {
          closePanel();
        }
      });

      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closePanel();
        }
      });

      closePanel();
    });
  }
</script>
