---
const gallery = [
  {
    title: 'Vein Direction',
    image: 'https://images.unsplash.com/photo-1533090161767-e6ffed986c88?q=80&w=1974&auto=format&fit=crop',
  },
  {
    title: 'Soft Honed Finish',
    image: 'https://images.unsplash.com/photo-1494526585095-c41746248156?q=80&w=1974&auto=format&fit=crop',
  },
  {
    title: 'Facade Rhythm',
    image: 'https://images.unsplash.com/photo-1511818966892-d7d671e672a2?q=80&w=1974&auto=format&fit=crop',
  },
  {
    title: 'Warm Aggregate',
    image: 'https://images.unsplash.com/photo-1604014237800-1c9102c219da?q=80&w=1974&auto=format&fit=crop',
  },
  {
    title: 'Precision Joinery',
    image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?q=80&w=2070&auto=format&fit=crop',
  },
];
---

<section id="gallery" class="bg-white py-24 md:py-32">
  <div class="mx-auto max-w-[1440px] px-4 md:px-8">
    <div class="reveal mb-12 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="mb-4 text-xs uppercase tracking-[0.3em] text-stone-500">Horizontal Gallery</p>
        <h2 class="font-display text-4xl font-light tracking-[-0.05em] text-stone-900 md:text-6xl">
          Scroll converts into a horizontal material archive, revealing detail before specification.
        </h2>
      </div>
      <p class="max-w-md text-base leading-7 text-stone-600">
        Every card carries only one detail, so the visitor reads surface quality the same way a design team studies a physical sample board.
      </p>
    </div>

    <div id="gallery-wrap" class="relative overflow-hidden rounded-[2.5rem] border border-stone-200 bg-stone-50 shadow-architectural">
      <div id="gallery-track" class="flex w-max gap-6 px-6 py-8 md:gap-8 md:px-8">
        {gallery.map((item) => (
          <article class="gallery-card reveal w-[78vw] max-w-[420px] shrink-0 overflow-hidden rounded-[2rem] border border-stone-200 bg-white shadow-[0_16px_48px_rgba(28,25,23,0.08)]">
            <div class="aspect-[4/5] overflow-hidden">
              <img src={item.image} alt={item.title} class="h-full w-full object-cover transition-transform duration-700 hover:scale-105" />
            </div>
            <div class="px-6 py-5">
              <p class="text-xs uppercase tracking-[0.24em] text-stone-400">Texture Study</p>
              <h3 class="mt-2 font-display text-2xl font-light tracking-[-0.03em] text-stone-900">{item.title}</h3>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    window.addEventListener('load', async () => {
      try {
        const gsap = (await import('gsap')).default;
        const ScrollTrigger = (await import('gsap/ScrollTrigger')).default;
        gsap.registerPlugin(ScrollTrigger);

        const track = document.getElementById('gallery-track');
        const wrap = document.getElementById('gallery-wrap');
        if (!track || !wrap) return;

        const getDistance = () => Math.max(0, track.scrollWidth - wrap.clientWidth);

        gsap.to(track, {
          x: () => -getDistance(),
          ease: 'none',
          scrollTrigger: {
            trigger: wrap,
            start: 'top top+=96',
            end: () => `+=${getDistance()}`,
            scrub: true,
            pin: true,
            invalidateOnRefresh: true,
          },
        });
      } catch (error) {
        console.error('Horizontal gallery initialization failed:', error);
      }
    });
  }
</script>
