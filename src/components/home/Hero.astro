---
import 'lite-youtube-embed/src/lite-yt-embed.css';
---

<section id="hero" class="relative isolate overflow-hidden bg-white pt-32 md:pt-36">
  <div class="absolute inset-x-0 top-0 h-[42rem] bg-radial-warm opacity-90"></div>
  <div class="mx-auto flex min-h-screen max-w-[1440px] flex-col justify-center px-4 pb-16 md:px-8">
    <div class="reveal mb-6 flex items-center justify-between gap-6">
      <p class="text-xs font-medium uppercase tracking-[0.32em] text-stone-500">Architectural Minimalism</p>
      <p class="hidden text-xs uppercase tracking-[0.24em] text-stone-400 md:block">Dubai / Riyadh / Moscow / London</p>
    </div>

    <div class="mb-14 grid items-end gap-10 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="space-y-8">
        <div class="overflow-hidden">
          <h1 class="hero-title font-display text-6xl font-light leading-[0.95] tracking-[-0.06em] text-stone-900 sm:text-7xl md:text-8xl lg:text-[8.5rem]">
            <span class="hero-word inline-block">Materials</span>
            <span class="hero-word inline-block">Shaped</span>
            <span class="hero-word inline-block">for</span>
            <span class="hero-word inline-block text-gradient-amber">Landmarks</span>
          </h1>
        </div>

        <p class="reveal max-w-2xl text-lg leading-8 text-stone-600 md:text-xl">
          We curate marble, porcelain, sintered stone, wood veneer, and facade systems for architecture firms that demand rigorous detailing, restrained luxury, and global delivery certainty.
        </p>

        <div class="reveal flex flex-col gap-4 sm:flex-row">
          <a href="#series" class="inline-flex items-center justify-center rounded-full bg-stone-900 px-8 py-4 text-sm font-medium uppercase tracking-[0.16em] text-white transition-all hover:-translate-y-0.5 hover:bg-amber-700 shadow-architectural">
            Explore Materials
          </a>
          <a href="#comparison" class="inline-flex items-center justify-center rounded-full border border-stone-300 bg-white/80 px-8 py-4 text-sm font-medium uppercase tracking-[0.16em] text-stone-900 transition-all hover:-translate-y-0.5 hover:border-amber-700 hover:text-amber-700">
            Request Specification
          </a>
        </div>
      </div>

      <div class="reveal justify-self-end text-left lg:max-w-sm">
        <p class="mb-3 text-xs uppercase tracking-[0.24em] text-stone-400">Design Narrative</p>
        <p class="text-base leading-7 text-stone-600">
          A bright spatial language with cinematic motion, blueprint rhythm, and tactile surfaces that feel closer to an international design institute than a traditional product catalog.
        </p>
      </div>
    </div>

    <div class="reveal relative overflow-hidden rounded-[3rem] border border-stone-200 bg-stone-50 p-3 shadow-architectural">
      <div class="pointer-events-none absolute inset-x-10 top-0 h-24 rounded-full bg-amber-100/60 blur-3xl"></div>
      <div class="overflow-hidden rounded-[2.5rem] bg-stone-900">
        <lite-youtube
          videoid="ScMzIvxBSi4"
          params="autoplay=1&mute=1&controls=0&loop=1&playlist=ScMzIvxBSi4&modestbranding=1&rel=0"
          playlabel="Architectural material showcase video"
          class="block aspect-[16/9] w-full"
        ></lite-youtube>
      </div>

      <div class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-between px-6 pb-6 md:px-10">
        <div class="glass-soft rounded-3xl px-5 py-4">
          <p class="text-[11px] uppercase tracking-[0.28em] text-stone-500">Featured Film</p>
          <p class="mt-1 text-sm text-stone-700">Quiet luxury surfaces for public architecture</p>
        </div>
        <div class="hidden items-center gap-3 md:flex">
          <span class="text-[11px] uppercase tracking-[0.28em] text-stone-400">Scroll</span>
          <div class="h-14 w-px bg-gradient-to-b from-stone-300 to-transparent"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import 'lite-youtube-embed';
</script>

<script>
  if (typeof window !== 'undefined') {
    window.addEventListener('load', async () => {
      try {
        const gsap = (await import('gsap')).default;

        gsap.set('.hero-word', {
          opacity: 0,
          scale: 0.88,
          filter: 'blur(14px)',
          transformOrigin: '50% 50%',
        });

        gsap.to('.hero-word', {
          opacity: 1,
          scale: 1,
          filter: 'blur(0px)',
          duration: 1.15,
          ease: 'power4.out',
          stagger: {
            each: 0.08,
            from: 'center',
          },
        });

        gsap.from('#hero lite-youtube', {
          y: 40,
          opacity: 0,
          scale: 0.96,
          duration: 1.1,
          ease: 'power3.out',
          delay: 0.2,
        });
      } catch (error) {
        console.error('Hero animation initialization failed:', error);
      }
    });
  }
</script>
