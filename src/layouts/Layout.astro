---
import '../styles/global.css';
import { defaultLocale, isRtlLocale, normalizeLocale, type SupportedLocale } from '../i18n/config';
import Footer from '../components/sections/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  locale?: SupportedLocale;
  lang?: string;
  dir?: string;
}

const {
  title = '建筑材料叙事',
  description = '以建筑叙事方式呈现高端材料与空间体验。',
  locale: localeProp,
  lang,
  dir = 'ltr',
} = Astro.props;

const locale = normalizeLocale(Astro.currentLocale ?? localeProp ?? lang ?? defaultLocale);
const textDirection = isRtlLocale(locale) ? 'rtl' : dir;
const pageTitle = title.includes('|') ? title : `${title} | Architectural Insulation`;
const globalBackgroundImage =
  'https://images.unsplash.com/photo-1513828583688-c52646db42da?q=80&w=2200&auto=format&fit=crop';

const uiFontStack = `"Inter", "Noto Sans", "Noto Sans SC", "Noto Sans Arabic", "Noto Sans Thai", "Noto Sans Devanagari", "Noto Sans JP", "Noto Sans KR", "Noto Sans TC", "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif`;
const displayFontStack = isRtlLocale(locale)
  ? `"Noto Sans Arabic", "Noto Naskh Arabic", "Noto Sans", "Segoe UI", system-ui, sans-serif`
  : locale === 'th'
    ? `"Noto Sans Thai", "Noto Sans", "Inter", system-ui, sans-serif`
    : locale === 'hi'
      ? `"Noto Sans Devanagari", "Noto Sans", "Inter", system-ui, sans-serif`
      : locale === 'ja'
        ? `"Noto Sans JP", "Inter", "Noto Sans", system-ui, sans-serif`
        : locale === 'ko'
          ? `"Noto Sans KR", "Inter", "Noto Sans", system-ui, sans-serif`
  : `"Inter", "Noto Sans SC", "Noto Sans", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif`;
---

<!DOCTYPE html>
<html
  lang={locale}
  dir={textDirection}
  class="bg-canvas"
  style={`--font-ui-stack:${uiFontStack}; --font-display-stack:${displayFontStack}; --page-atmosphere-image:url('${globalBackgroundImage}');`}
>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- TODO: 接入 Facebook Pixel & GTM -->
  <style>
    html, body {
      width: 100%;
      min-height: 100%;
      background: #f6f7f9;
    }

    body {
      font-family: var(--font-ui-stack);
    }

    .font-serif,
    .font-display {
      font-family: var(--font-display-stack);
    }

    .lenis.lenis-smooth {
      scroll-behavior: auto !important;
    }

    .lenis.lenis-smooth [data-lenis-prevent] {
      overscroll-behavior: contain;
    }

    .lenis.lenis-stopped {
      overflow: hidden;
    }
  </style>
</head>

<body class="font-sans antialiased text-ink selection:bg-black/10 selection:text-ink">
  <main class="page-shell editorial-shell relative min-h-screen">
    <div
      class="pointer-events-none fixed inset-0 z-[-4] bg-cover bg-center bg-no-repeat opacity-[0.18]"
      style={`background-image:url('${globalBackgroundImage}'); filter: grayscale(18%) saturate(78%) contrast(0.92);`}
    ></div>
    <div class="pointer-events-none fixed inset-0 z-[-3] bg-[linear-gradient(180deg,rgba(243,241,236,0.82)_0%,rgba(236,232,223,0.9)_42%,rgba(231,226,215,0.95)_100%)]"></div>
    <div class="pointer-events-none fixed inset-0 z-[-2] bg-[linear-gradient(90deg,rgba(255,255,255,0.32)_0%,rgba(255,255,255,0.08)_28%,rgba(255,255,255,0.08)_72%,rgba(255,255,255,0.26)_100%),radial-gradient(circle_at_top_left,rgba(107,98,85,0.1),transparent_24%),radial-gradient(circle_at_85%_12%,rgba(42,47,54,0.06),transparent_18%),radial-gradient(circle_at_50%_100%,rgba(255,255,255,0.6),transparent_26%)]"></div>
    <div class="pointer-events-none fixed inset-0 z-[-1] editorial-grid opacity-30"></div>
    <div class="page-flow">
      <slot />
      <Footer />
    </div>
  </main>

  <script>
    if (typeof window !== 'undefined') {
      window.addEventListener('load', async () => {
        try {
          const gsap = (await import('gsap')).default;
          const ScrollTrigger = (await import('gsap/ScrollTrigger')).default;

          gsap.registerPlugin(ScrollTrigger);

          const scrollTo = (target) => {
            if (!(target instanceof Element)) return;
            const top = target.getBoundingClientRect().top + window.scrollY - 96;
            window.scrollTo({ top, behavior: 'smooth' });
          };

          window.__Cinematic = {
            gsap,
            ScrollTrigger,
            scrollTo,
          };

          const revealNodes = gsap.utils.toArray('[data-animate]');
          revealNodes.forEach((node) => {
            gsap.from(node, {
              y: 28,
              opacity: 0,
              duration: 0.9,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: node,
                start: 'top 86%',
                once: true,
              },
            });
          });

          const staggerGroups = gsap.utils.toArray('[data-animate-group]');
          staggerGroups.forEach((group) => {
            const items = group.querySelectorAll('[data-animate-item]');
            if (!items.length) return;

            gsap.from(items, {
              y: 28,
              opacity: 0,
              duration: 0.85,
              ease: 'power2.out',
              stagger: 0.1,
              scrollTrigger: {
                trigger: group,
                start: 'top 82%',
                once: true,
              },
            });
          });

          window.dispatchEvent(new CustomEvent('cinematic:ready'));
          ScrollTrigger.refresh();

          document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
            anchor.addEventListener('click', (event) => {
              const href = anchor.getAttribute('href');
              if (!href || href === '#') return;

              const target = document.querySelector(href);
              if (!target) return;

              event.preventDefault();
              scrollTo(target);
            });
          });

          window.addEventListener('resize', () => {
            ScrollTrigger.refresh();
          });

        } catch (e) {
          console.error('Global Engine Error:', e);
        }
      });
    }
  </script>
</body>
</html>
