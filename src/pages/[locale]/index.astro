---
import HomePage from '../../components/pages/HomePage.astro';
import { secondaryLocales, type SupportedLocale } from '../../i18n/config';

export function getStaticPaths() {
  return secondaryLocales.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: SupportedLocale };
---

<HomePage locale={locale} />
