    { id: 'channels', label: '联系方式' },
    { id: 'rfq', label: '项目询价' },
    { id: 'visit', label: '来访指南' },
  ]}
  sections={[
    {
      id: 'channels',
      label: '联系方式',
      title: '多种渠道，快速响应',
