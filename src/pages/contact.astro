      ],
    },
    {
      id: 'rfq',
      label: '项目询价',
      title: '提供项目信息，获取精准报价',
      body: '请尽可能提供项目类型、建筑面积、应用场景、产品类型、规格需求及预计用量等信息。完善的项目资料将帮助我们更准确地完成选型建议与价格核算。',
      stat: '资料完备，报价更快',
