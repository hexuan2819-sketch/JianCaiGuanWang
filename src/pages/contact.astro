        { label: '项目类型', value: '商业 / 工业 / 公共建筑' },
        { label: '产品需求', value: '玻璃棉毡 / 橡塑保温管 / 综合' },
        { label: '技术参数', value: '密度 / 厚度 / 覆面要求' },
