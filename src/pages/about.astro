        { label: '核心产品', value: '玻璃棉毡 / 橡塑保温管' },
        { label: '产能规模', value: '12+ 条自动化生产线' },
        { label: '项目经验', value: '500+ 已交付项目' },
        { label: '客户类型', value: '设计院 / 总包 / 机电分包' },
